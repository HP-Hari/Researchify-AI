    replacement_chunks {
      replacement_content: "export interface ExpertPersona {\n  title: string;\n  focus_domain: string;\n  system_instruction: string;\n}\n\nexport interface TrackQueries {\n  focus: string;\n  primary_queries: string[];\n  leaf_queries?: string[];\n}\n\nexport type ToTTree = Record<string, Record<string, TrackQueries>>;\n\nexport interface FactRecord {\n  fact_id: string;\n  claim: string;\n  associated_sources: string[];\n  is_contradictory: boolean;\n  conflict_details: string | null;\n  metric_category?: \'INFRASTRUCTURE\' | \'FINANCIAL\' | \'REGULATORY\' | \'OPERATIONAL\' | \'COMPETITIVE\';\n  extracted_date?: string;\n  extracted_metric?: string;\n}\n\nexport interface MapReduceOutput {\n  clean_records: FactRecord[];\n  mapper_stats?: {\n    raw_assertions_extracted: number;\n    unique_domains_queried: number;\n    contradictions_isolated: number;\n    deduplication_ratio: string;\n  };\n}\n\nexport interface OperationalVariable {\n  variable_name: string;\n  metric: string;\n  status: \'VERIFIED\' | \'DISPUTED\' | \'HIGH_SENSITIVITY\' | \'UNHEDGED\';\n  governing_expert: string;\n  sensitivity: \'LOW\' | \'MEDIUM\' | \'HIGH\' | \'FATAL\';\n}\n\nexport interface DelphiBrief {\n  expert_title: string;\n  focus_domain: string;\n  domain_critique: string;\n  infrastructure_bottlenecks: string[];\n  financial_stress_points: string[];\n  single_point_of_failure_risks: string[];\n  unhedged_assumptions: string[];\n}\n\nexport interface CrossDomainBlindSpot {\n  primary_expert: string;\n  challenging_expert: string;\n  invalidating_variable: string;\n  strategic_impact: string;\n}\n\nexport interface DelphiOutput {\n  expert_briefs: DelphiBrief[];\n  operational_variables: OperationalVariable[];\n  cross_domain_blind_spots: CrossDomainBlindSpot[];\n  consensus_summary: string;\n}\n\nexport interface AdversarialDebateTurn {\n  speaker: \'EXPANSION_VISIONARY\' | \'CYNICAL_RISK_AUDITOR\';\n  round: 1 | 2;\n  argument: string;\n  cited_fact_ids: string[];\n  vulnerability_targeted?: string;\n}\n\nexport interface AdjudicatedClaim {\n  claim_id: string;\n  target_assertion: string;\n  pro_argument_summary: string;\n  con_argument_summary: string;\n  epistemic_certainty_percentage: number;\n  verdict_justification: string;\n  risk_status: \'DISPUTED_OPERATIONAL_VARIABLE\' | \'HIGH_CERTAINTY_VERIFIED\' | \'CRITICAL_UNHEDGED_RISK\' | \'REGULATORY_FATAL_FLAW\';\n}\n\nexport interface AdversarialOutput {\n  debate_transcript: AdversarialDebateTurn[];\n  adjudicated_claims: AdjudicatedClaim[];\n  overall_epistemic_certainty: number;\n  decision_posture: \'GO\' | \'CONDITIONAL_GO\' | \'NO_GO\';\n}\n\nexport interface MasterReportOutput {\n  markdown_report: string;\n  investment_verdict: \'GO\' | \'CONDITIONAL_GO\' | \'NO_GO\';\n  certainty_score: number;\n  critical_risk_count: number;\n  verified_source_count: number;\n  sources: Array<{ id: number; title: string; url: string; claim_reference: string }>;\n}\n\nexport interface ResearchPipelineData {\n  id: string;\n  timestamp: string;\n  query: string;\n  status: \'idle\' | \'running\' | \'completed\' | \'error\';\n  currentPhase: number;\n  error?: string;\n  phase1_dps?: ExpertPersona[];\n  phase2_tot?: ToTTree;\n  phase3_mapreduce?: MapReduceOutput;\n  phase4_delphi?: DelphiOutput;\n  phase5_adversarial?: AdversarialOutput;\n  phase6_report?: MasterReportOutput;\n  logs: Array<{ timestamp: string; phase: number; message: string; type?: \'info\' | \'warn\' | \'success\' | \'alert\' }>;\n}\n"
    }
