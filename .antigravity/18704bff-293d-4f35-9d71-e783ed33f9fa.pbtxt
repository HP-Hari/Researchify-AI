      replacement_content: "import React, { useRef, useEffect } from \'react\';\nimport { Terminal, ShieldAlert, CheckCircle2, AlertTriangle, Info } from \'lucide-react\';\n\ninterface PipelineLog {\n  timestamp: string;\n  phase: number;\n  message: string;\n  type?: \'info\' | \'warn\' | \'success\' | \'alert\';\n}\n\ninterface PipelineLiveLogsProps {\n  logs: PipelineLog[];\n  isStreaming?: boolean;\n}\n\nexport const PipelineLiveLogs: React.FC<PipelineLiveLogsProps> = ({ logs, isStreaming }) => {\n  const scrollRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    if (scrollRef.current) {\n      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\n    }\n  }, [logs]);\n\n  return (\n    <div className=\"rounded-xl bg-slate-950 border border-slate-800/90 overflow-hidden shadow-xl\">\n      <div className=\"p-2.5 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between text-xs font-mono\">\n        <div className=\"flex items-center gap-2 text-slate-300\">\n          <Terminal className=\"w-3.5 h-3.5 text-cyan-400\" />\n          <span className=\"font-semibold\">ORCHESTRATION EVENT STREAM</span>\n          {isStreaming && (\n            <span className=\"flex items-center gap-1 text-[10px] text-cyan-400 bg-cyan-950/60 px-1.5 py-0.5 rounded border border-cyan-800\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping\"></span>\n              STREAMING\n            </span>\n          )}\n        </div>\n        <span className=\"text-slate-500 text-[11px]\">{logs.length} telemetry events</span>\n      </div>\n\n      <div\n        ref={scrollRef}\n        className=\"p-3 max-h-48 overflow-y-auto space-y-1.5 text-xs font-mono bg-slate-950/90\"\n      >\n        {logs.length === 0 ? (\n          <div className=\"text-slate-600 italic py-2 text-center\">\n            System standing by. Enter a query or select a preset proposition to engage grid.\n          </div>\n        ) : (\n          logs.map((log, idx) => {\n            const timeStr = new Date(log.timestamp).toLocaleTimeString();\n            return (\n              <div key={idx} className=\"flex items-start gap-2 leading-relaxed\">\n                <span className=\"text-slate-600 text-[10px] shrink-0 mt-0.5\">{timeStr}</span>\n                <span className=\"text-[10px] px-1 rounded bg-slate-900 text-slate-400 border border-slate-800 shrink-0\">\n                  P{log.phase}\n                </span>\n\n                <div className=\"flex items-center gap-1.5 flex-1 min-w-0\">\n                  {log.type === \'alert\' || log.message.includes(\'Contradiction\') ? (\n                    <AlertTriangle className=\"w-3 h-3 text-rose-400 shrink-0\" />\n                  ) : log.type === \'warn\' ? (\n                    <ShieldAlert className=\"w-3 h-3 text-amber-400 shrink-0\" />\n                  ) : log.type === \'success\' ? (\n                    <CheckCircle2 className=\"w-3 h-3 text-emerald-400 shrink-0\" />\n                  ) : (\n                    <Info className=\"w-3 h-3 text-cyan-400 shrink-0\" />\n                  )}\n\n                  <span\n                    className={`break-words ${\n                      log.type === \'alert\' || log.message.includes(\'Contradiction\')\n                        ? \'text-rose-300 font-semibold\'\n                        : log.type === \'warn\'\n                        ? \'text-amber-300\'\n                        : log.type === \'success\'\n                        ? \'text-emerald-300\'\n                        : \'text-slate-300\'\n                    }`}\n                  >\n                    {log.message}\n                  </span>\n                </div>\n              </div>\n            );\n          })\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
