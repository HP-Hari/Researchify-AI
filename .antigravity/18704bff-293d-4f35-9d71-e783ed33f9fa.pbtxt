    command_line: "node -e \"\nasync function searchDuckDuckGo(q) {\n  try {\n    const res = await fetch(\'https://html.duckduckgo.com/html/?q=\' + encodeURIComponent(q), {\n      headers: { \'User-Agent\': \'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\' },\n      signal: AbortSignal.timeout(5000),\n    });\n    if (!res.ok) return [];\n    const html = await res.text();\n    const items = [];\n    const regex = /<h2 class=\\\"result__title\\\">[\\s\\S]*?<a rel=\\\"nofollow\\\" class=\\\"result__a\\\" href=\\\"([^\\\"]*uddg=([^\\\"]*?)(&|&amp;)[^\\\"]*)\\\"[^>]*>([\\s\\S]*?)<\\/a>[\\s\\S]*?<a class=\\\"result__snippet[^\\\"]*\\\"[^>]*>([\\s\\S]*?)<\\/a>/g;\n    let match;\n    while ((match = regex.exec(html)) !== null && items.length < 6) {\n      const rawUrl = decodeURIComponent(match[2]);\n      const title = match[4].replace(/<[^>]+>/g, \'\').trim();\n      const snippet = match[5].replace(/<[^>]+>/g, \'\').trim();\n      if (rawUrl.startsWith(\'http\') && !rawUrl.includes(\'duckduckgo.com\')) {\n        items.push({ title, url: rawUrl, snippet, source: \'web\' });\n      }\n    }\n    return items;\n  } catch (e) {\n    return [];\n  }\n}\n\nasync function searchWikipedia(q) {\n  try {\n    const res = await fetch(\'https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=\' + encodeURIComponent(q) + \'&format=json&origin=*\', {\n      headers: { \'User-Agent\': \'ResearchifyBot/1.0\' },\n      signal: AbortSignal.timeout(4000),\n    });\n    if (!res.ok) return [];\n    const d = await res.json();\n    return (d.query?.search || []).slice(0, 4).map(s => ({\n      title: s.title,\n      url: \'https://en.wikipedia.org/wiki/\' + encodeURIComponent(s.title.replace(/ /g, \'_\')),\n      snippet: s.snippet.replace(/<[^>]+>/g, \'\').trim(),\n      source: \'wikipedia\'\n    }));\n  } catch (e) {\n    return [];\n  }\n}\n\nPromise.all([\n  searchDuckDuckGo(\'Sodium Ion battery utility scale ERCOT 2025 2026\'),\n  searchWikipedia(\'Sodium-ion battery\')\n]).then(([web, wiki]) => {\n  console.log(\'Total live results:\', web.length + wiki.length);\n  console.log(\'Sample web result:\', web[0]);\n  console.log(\'Sample wiki result:\', wiki[0]);\n});\n\""
