  file_change {
    absolute_path_uri: "file:///src/components/MarkdownRenderer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\n\ninterface MarkdownRendererProps {\n  content: string;\n  sources?: Array<{ id: number; title: string; url: string; claim_reference: string }>;\n}\n\nexport const MarkdownRenderer: React.FC<MarkdownRendererProps> = ({ content, sources }) => {\n  // Parse markdown lines into React elements\n  const renderFormattedText = (text: string) => {\n    // Replace [^N] with anchor links\n    const parts = text.split(/(\\[\\^[0-9]+\\])/g);\n    return parts.map((part, i) => {\n      const footnoteMatch = part.match(/\\[\\^([0-9]+)\\]/);\n      if (footnoteMatch) {\n        const id = parseInt(footnoteMatch[1], 10);\n        const source = sources?.find(s => s.id === id);\n        return (\n          <sup key={i} className=\"inline-block ml-0.5\">\n            <a\n              href={source ? source.url : `#source-${id}`}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              title={source ? `${source.title}: ${source.claim_reference}` : `Source [^${id}]`}\n              className=\"px-1.5 py-0.5 text-xs font-mono font-bold bg-cyan-950/80 text-cyan-400 border border-cyan-800/60 rounded hover:bg-cyan-900 transition-colors\"\n            >\n              [{id}]\n            </a>\n          </sup>\n        );\n      }\n\n      // Handle bold text **text**\n      const boldParts = part.split(/(\\*\\*[^*]+\\*\\*)/g);\n      return boldParts.map((bPart, j) => {\n        if (bPart.startsWith(\'**\') && bPart.endsWith(\'**\')) {\n          const inner = bPart.slice(2, -2);\n          // Highlight decision outcomes\n          if (inner.includes(\'GO\') || inner.includes(\'DECISION\') || inner.includes(\'VERDICT\')) {\n            const isNoGo = inner.includes(\'NO-GO\') || inner.includes(\'NO_GO\');\n            const isConditional = inner.includes(\'CONDITIONAL\');\n            return (\n              <span\n                key={`${i}-${j}`}\n                className={`font-extrabold tracking-wide px-2 py-0.5 rounded text-sm ${\n                  isNoGo\n                    ? \'bg-rose-950/80 text-rose-300 border border-rose-800\'\n                    : isConditional\n                    ? \'bg-amber-950/80 text-amber-300 border border-amber-800\'\n                    : \'bg-emerald-950/80 text-emerald-300 border border-emerald-800\'\n                }`}\n              >\n                {inner}\n              </span>\n            );\n          }\n          return <strong key={`${i}-${j}`} className=\"text-slate-100 font-semibold\">{inner}</strong>;\n        }\n\n        // Handle inline code `code`\n        const codeParts = bPart.split(/(`[^`]+`)/g);\n        return codeParts.map((cPart, k) => {\n          if (cPart.startsWith(\'`\') && cPart.endsWith(\'`\')) {\n            return (\n              <code key={`${i}-${j}-${k}`} className=\"px-1.5 py-0.5 bg-slate-900 text-cyan-300 font-mono text-xs rounded border border-slate-800\">\n                {cPart.slice(1, -1)}\n              </code>\n            );\n          }\n          return cPart;\n        });\n      });\n    });\n  };\n\n  const lines = content.split(\'\\n\');\n  const elements: React.ReactNode[] = [];\n  let inTable = false;\n  let tableRows: string[][] = [];\n  let tableHeader: string[] = [];\n\n  const flushTable = (key: number) => {\n    if (tableHeader.length > 0 || tableRows.length > 0) {\n      elements.push(\n        <div key={`table-${key}`} className=\"overflow-x-auto my-5\">\n          <table className=\"min-w-full text-xs md:text-sm text-left border border-slate-800 rounded-lg overflow-hidden\">\n            {tableHeader.length > 0 && (\n              <thead className=\"bg-slate-900/90 text-slate-300 uppercase tracking-wider font-mono text-xs border-b border-slate-800\">\n                <tr>\n                  {tableHeader.map((th, hIdx) => (\n                    <th key={hIdx} className=\"px-3.5 py-2.5\">\n                      {renderFormattedText(th.trim())}\n                    </th>\n                  ))}\n                </tr>\n              </thead>\n            )}\n            <tbody className=\"divide-y divide-slate-800/60 bg-slate-950/60 font-sans\">\n              {tableRows.map((row, rIdx) => (\n                <tr key={rIdx} className=\"hover:bg-slate-900/40 transition-colors\">\n                  {row.map((cell, cIdx) => (\n                    <td key={cIdx} className=\"px-3.5 py-2.5 text-slate-200\">\n                      {renderFormattedText(cell.trim())}\n                    </td>\n                  ))}\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      );\n    }\n    inTable = false;\n    tableRows = [];\n    tableHeader = [];\n  };\n\n  for (let idx = 0; idx < lines.length; idx++) {\n    const line = lines[idx];\n\n    // Check table markdown\n    if (line.trim().startsWith(\'|\') && line.trim().endsWith(\'|\')) {\n      const cells = line\n        .trim()\n        .slice(1, -1)\n        .split(\'|\')\n        .map(c => c.trim());\n\n      // Check if it\'s separator row (|---|---|)\n      if (cells.every(c => c.replace(/[:\\-]/g, \'\').length === 0)) {\n        continue;\n      }\n\n      if (!inTable) {\n        inTable = true;\n        tableHeader = cells;\n      } else {\n        tableRows.push(cells);\n      }\n      continue;\n    } else if (inTable) {\n      flushTable(idx);\n    }\n\n    if (line.startsWith(\'# \')) {\n      elements.push(\n        <h1 key={idx} className=\"text-2xl font-bold tracking-tight text-slate-100 border-b border-slate-800 pb-3 mt-6 mb-4 flex items-center gap-2\">\n          <span className=\"w-2.5 h-6 bg-cyan-500 rounded-sm inline-block\"></span>\n          {renderFormattedText(line.slice(2))}\n        </h1>\n      );\n    } else if (line.startsWith(\'## \')) {\n      elements.push(\n        <h2 key={idx} className=\"text-lg md:text-xl font-bold text-cyan-400 mt-6 mb-3 flex items-center gap-2\">\n          <span className=\"w-1.5 h-4 bg-cyan-400 rounded-full inline-block\"></span>\n          {renderFormattedText(line.slice(3))}\n        </h2>\n      );\n    } else if (line.startsWith(\'### \')) {\n      elements.push(\n        <h3 key={idx} className=\"text-base font-semibold text-slate-200 mt-4 mb-2\">\n          {renderFormattedText(line.slice(4))}\n        </h3>\n      );\n    } else if (line.startsWith(\'* \') || line.startsWith(\'- \')) {\n      elements.push(\n        <li key={idx} className=\"text-sm text-slate-300 ml-4 list-disc mb-1 leading-relaxed\">\n          {renderFormattedText(line.slice(2))}\n        </li>\n      );\n    } else if (/^\\d+\\.\\s/.test(line)) {\n      const match = line.match(/^(\\d+\\.)\\s(.*)$/);\n      elements.push(\n        <li key={idx} className=\"text-sm text-slate-300 ml-4 list-decimal mb-1 leading-relaxed\">\n          {renderFormattedText(match ? match[2] : line)}\n        </li>\n      );\n    } else if (line.startsWith(\'> \')) {\n      elements.push(\n        <blockquote key={idx} className=\"border-l-2 border-cyan-500 pl-3 my-2 text-sm text-slate-400 italic bg-cyan-950/20 py-1.5 rounded-r\">\n          {renderFormattedText(line.slice(2))}\n        </blockquote>\n      );\n    } else if (line.trim() === \'---\') {\n      elements.push(<hr key={idx} className=\"border-slate-800 my-6\" />);\n    } else if (line.trim().length > 0) {\n      elements.push(\n        <p key={idx} className=\"text-sm text-slate-300 leading-relaxed mb-3\">\n          {renderFormattedText(line)}\n        </p>\n      );\n    }\n  }\n\n  if (inTable) {\n    flushTable(lines.length);\n  }\n\n  return <div className=\"report-content font-sans\">{elements}</div>;\n};\n"
    }
