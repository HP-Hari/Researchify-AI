  file_change {
    absolute_path_uri: "file:///src/components/NodePipelineTracker.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  Users,\n  GitFork,\n  Network,\n  Scale,\n  Swords,\n  FileCheck2,\n  CheckCircle2,\n  CircleDashed,\n  AlertCircle,\n  Play,\n} from \'lucide-react\';\nimport type { ResearchPipelineData } from \'../types\';\n\ninterface NodePipelineTrackerProps {\n  pipelineData: ResearchPipelineData;\n  activeTab: number;\n  onSelectTab: (phase: number) => void;\n  onExecuteStep?: (phase: number) => void;\n  isExecutingStep?: boolean;\n}\n\nconst PHASES = [\n  {\n    phase: 1,\n    id: \'dps\',\n    label: \'Phase 1: DPS Node\',\n    name: \'Dynamic Persona Synthesizer\',\n    icon: Users,\n    description: \'Synthesize 3 hyper-specialized expert profiles\',\n  },\n  {\n    phase: 2,\n    id: \'tot\',\n    label: \'Phase 2: ToT Router\',\n    name: \'Asymmetric Tree-of-Thought\',\n    icon: GitFork,\n    description: \'3 root tracks & multi-parameter query branches\',\n  },\n  {\n    phase: 3,\n    id: \'mapreduce\',\n    label: \'Phase 3: MapReduce\',\n    name: \'Ingestion & Collision Radar\',\n    icon: Network,\n    description: \'Weld source URLs & tag contradictory collisions\',\n  },\n  {\n    phase: 4,\n    id: \'delphi\',\n    label: \'Phase 4: Delphi Panel\',\n    name: \'Multi-Perspective Consensus\',\n    icon: Scale,\n    description: \'Domain briefs & cross-domain blind spots\',\n  },\n  {\n    phase: 5,\n    id: \'adversarial\',\n    label: \'Phase 5: BAC Loop\',\n    name: \'Adversarial & Adjudication\',\n    icon: Swords,\n    description: \'2-round collision debate & Epistemic Certainty\',\n  },\n  {\n    phase: 6,\n    id: \'report\',\n    label: \'Phase 6: Master Compiler\',\n    name: \'Investment Report Compiler\',\n    icon: FileCheck2,\n    description: \'7-part executive markdown master dossier\',\n  },\n];\n\nexport const NodePipelineTracker: React.FC<NodePipelineTrackerProps> = ({\n  pipelineData,\n  activeTab,\n  onSelectTab,\n  onExecuteStep,\n  isExecutingStep,\n}) => {\n  const isPhaseCompleted = (phaseNum: number): boolean => {\n    switch (phaseNum) {\n      case 1:\n        return !!pipelineData.phase1_dps;\n      case 2:\n        return !!pipelineData.phase2_tot;\n      case 3:\n        return !!pipelineData.phase3_mapreduce;\n      case 4:\n        return !!pipelineData.phase4_delphi;\n      case 5:\n        return !!pipelineData.phase5_adversarial;\n      case 6:\n        return !!pipelineData.phase6_report;\n      default:\n        return false;\n    }\n  };\n\n  const isPhaseCurrent = (phaseNum: number): boolean => {\n    return pipelineData.status === \'running\' && pipelineData.currentPhase === phaseNum;\n  };\n\n  const canExecuteNextStep = (phaseNum: number): boolean => {\n    if (pipelineData.status === \'running\') return false;\n    if (phaseNum === 1) return !pipelineData.phase1_dps;\n    return isPhaseCompleted(phaseNum - 1) && !isPhaseCompleted(phaseNum);\n  };\n\n  return (\n    <div className=\"w-full bg-slate-900/50 border-y border-slate-800/80 px-4 lg:px-8 py-3\">\n      <div className=\"max-w-7xl mx-auto flex flex-col gap-2\">\n        {/* Navigation Step Pills */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2\">\n          {PHASES.map((item) => {\n            const completed = isPhaseCompleted(item.phase);\n            const current = isPhaseCurrent(item.phase);\n            const selected = activeTab === item.phase;\n            const canRun = canExecuteNextStep(item.phase);\n            const Icon = item.icon;\n\n            return (\n              <button\n                key={item.phase}\n                onClick={() => onSelectTab(item.phase)}\n                className={`flex flex-col text-left p-2.5 rounded-xl border transition-all cursor-pointer relative overflow-hidden group ${\n                  selected\n                    ? \'bg-slate-800/90 border-cyan-500/70 shadow-lg shadow-cyan-500/10\'\n                    : completed\n                    ? \'bg-slate-900/70 border-emerald-900/50 hover:border-emerald-700/60\'\n                    : current\n                    ? \'bg-slate-900/80 border-cyan-500/40 ring-1 ring-cyan-500/30\'\n                    : \'bg-slate-950/40 border-slate-800/60 opacity-70 hover:opacity-100\'\n                }`}\n              >\n                {/* Active scan line */}\n                {current && (\n                  <div className=\"absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-transparent via-cyan-400 to-transparent animate-pulse\" />\n                )}\n\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <div\n                    className={`w-6 h-6 rounded-lg flex items-center justify-center text-xs ${\n                      completed\n                        ? \'bg-emerald-950 text-emerald-400 border border-emerald-800\'\n                        : current\n                        ? \'bg-cyan-950 text-cyan-400 border border-cyan-700 animate-pulse\'\n                        : \'bg-slate-900 text-slate-400 border border-slate-800\'\n                    }`}\n                  >\n                    <Icon className=\"w-3.5 h-3.5\" />\n                  </div>\n\n                  {completed ? (\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n                  ) : current ? (\n                    <CircleDashed className=\"w-4 h-4 text-cyan-400 animate-spin\" />\n                  ) : canRun && onExecuteStep ? (\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onExecuteStep(item.phase);\n                      }}\n                      disabled={isExecutingStep}\n                      className=\"p-1 rounded bg-cyan-500/20 text-cyan-300 hover:bg-cyan-500/30 text-[10px] font-mono flex items-center gap-1 border border-cyan-500/40\"\n                    >\n                      <Play className=\"w-2.5 h-2.5 fill-current\" />\n                      <span>Run</span>\n                    </button>\n                  ) : (\n                    <span className=\"text-[10px] font-mono text-slate-600\">\n                      P{item.phase}\n                    </span>\n                  )}\n                </div>\n\n                <div className=\"text-[11px] font-mono text-slate-400 uppercase tracking-wider truncate\">\n                  {item.label}\n                </div>\n                <div className=\"text-xs font-semibold text-slate-200 truncate mt-0.5\">\n                  {item.name}\n                </div>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
