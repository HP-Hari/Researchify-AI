    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ShieldCheck, Cpu, Database, AlertTriangle, FileText, Download, RotateCcw, Sparkles } from \'lucide-react\';\nimport type { ResearchPipelineData } from \'../types\';\n\ninterface HeaderProps {\n  pipelineData: ResearchPipelineData | null;\n  onSelectPresetModal: () => void;\n  onReset: () => void;\n  onExportJson: () => void;\n  onExportMarkdown: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  pipelineData,\n  onSelectPresetModal,\n  onReset,\n  onExportJson,\n  onExportMarkdown,\n}) => {\n  return (\n    <header className=\"border-b border-slate-800 bg-slate-950/80 backdrop-blur-md sticky top-0 z-40 px-4 lg:px-8 py-3.5\">\n      <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-3\">\n        {/* Brand identity */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500/20 via-blue-500/20 to-indigo-500/20 border border-cyan-500/30 shadow-lg shadow-cyan-500/10\">\n            <Cpu className=\"w-5 h-5 text-cyan-400\" />\n            <span className=\"absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping\"></span>\n            <span className=\"absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-emerald-500\"></span>\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"text-xl font-bold tracking-tight text-white font-mono flex items-center gap-1.5\">\n                RESEARCHIFY<span className=\"text-cyan-400\">.AI</span>\n              </h1>\n              <span className=\"px-2 py-0.5 text-[10px] font-mono tracking-widest uppercase rounded bg-slate-900 text-slate-400 border border-slate-800\">\n                ORCHESTRATION CORE\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-400 tracking-wide font-sans\">\n              Non-linear, self-correcting market intelligence & adversarial verification engine\n            </p>\n          </div>\n        </div>\n\n        {/* Protocol Security Status Pills */}\n        <div className=\"hidden xl:flex items-center gap-2\">\n          <div className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900/90 border border-slate-800 text-[11px] font-mono text-slate-300\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span>Zero Leakage Law:</span>\n            <span className=\"text-emerald-400 font-semibold\">ENFORCED</span>\n          </div>\n          <div className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900/90 border border-slate-800 text-[11px] font-mono text-slate-300\">\n            <AlertTriangle className=\"w-3.5 h-3.5 text-amber-400\" />\n            <span>Contradiction Isolation:</span>\n            <span className=\"text-amber-400 font-semibold\">ARMED</span>\n          </div>\n          <div className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-900/90 border border-slate-800 text-[11px] font-mono text-slate-300\">\n            <Database className=\"w-3.5 h-3.5 text-cyan-400\" />\n            <span>5 Isolated Nodes:</span>\n            <span className=\"text-cyan-400 font-semibold\">ACTIVE</span>\n          </div>\n        </div>\n\n        {/* Global Actions */}\n        <div className=\"flex items-center gap-2 self-end md:self-auto\">\n          <button\n            onClick={onSelectPresetModal}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-slate-700 transition-all cursor-pointer\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-cyan-400\" />\n            <span>Curated Presets</span>\n          </button>\n\n          {pipelineData?.phase6_report && (\n            <>\n              <button\n                onClick={onExportMarkdown}\n                title=\"Export Markdown Master Report\"\n                className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-slate-700 transition-all cursor-pointer\"\n              >\n                <FileText className=\"w-3.5 h-3.5 text-blue-400\" />\n                <span className=\"hidden sm:inline\">Export Report</span>\n              </button>\n\n              <button\n                onClick={onExportJson}\n                title=\"Export Complete Structured Pipeline Dossier (JSON)\"\n                className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-slate-700 transition-all cursor-pointer\"\n              >\n                <Download className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span className=\"hidden sm:inline\">JSON Dossier</span>\n              </button>\n            </>\n          )}\n\n          {pipelineData && (\n            <button\n              onClick={onReset}\n              title=\"Reset and start new inquiry\"\n              className=\"p-1.5 rounded-lg text-xs bg-slate-900 hover:bg-rose-950/40 text-slate-400 hover:text-rose-300 border border-slate-800 hover:border-rose-900 transition-all cursor-pointer\"\n            >\n              <RotateCcw className=\"w-4 h-4\" />\n            </button>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
