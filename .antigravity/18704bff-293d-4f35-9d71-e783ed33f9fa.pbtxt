  file_change {
    absolute_path_uri: "file:///src/components/Phase4DelphiView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Scale,\n  AlertOctagon,\n  TrendingDown,\n  Layers,\n  ArrowRight,\n  ShieldAlert,\n  Zap,\n} from \'lucide-react\';\nimport type { DelphiOutput } from \'../types\';\n\ninterface Phase4DelphiViewProps {\n  delphi?: DelphiOutput;\n  onNextPhase?: () => void;\n}\n\nexport const Phase4DelphiView: React.FC<Phase4DelphiViewProps> = ({ delphi, onNextPhase }) => {\n  const [selectedExpertIdx, setSelectedExpertIdx] = useState(0);\n\n  if (!delphi || !delphi.expert_briefs || delphi.expert_briefs.length === 0) {\n    return (\n      <div className=\"p-8 text-center bg-slate-900/40 rounded-2xl border border-slate-800 text-slate-400\">\n        <Scale className=\"w-10 h-10 mx-auto text-slate-600 mb-3 animate-pulse\" />\n        <p className=\"text-sm font-mono\">Delphi Panel running multi-perspective cross-examination...</p>\n      </div>\n    );\n  }\n\n  const activeBrief = delphi.expert_briefs[selectedExpertIdx] || delphi.expert_briefs[0];\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-slate-900/80 border border-slate-800\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-2 py-0.5 rounded text-[10px] font-mono bg-purple-950 text-purple-400 border border-purple-800\">\n              PHASE 4 : DELPHI PANEL CONSENSUS\n            </span>\n            <span className=\"text-xs font-mono text-cyan-400 flex items-center gap-1\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-cyan-400\"></span>\n              Multi-Perspective Skeptical Framework\n            </span>\n          </div>\n          <h3 className=\"text-lg font-bold text-white mt-1\">\n            Multi-Perspective Delphi Panel Cross-Domain Framework\n          </h3>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Three synthesized experts independently stress-test the empirical fact database, isolating single points of failure and cross-invalidating assumptions.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n          {onNextPhase && (\n            <button\n              onClick={onNextPhase}\n              className=\"px-3 py-1 rounded-lg bg-purple-500/20 hover:bg-purple-500/30 text-purple-300 text-xs font-mono border border-purple-500/40 cursor-pointer\"\n            >\n              Advance to BAC Adversarial Loop &rarr;\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Consensus Summary Alert */}\n      {delphi.consensus_summary && (\n        <div className=\"p-4 rounded-xl bg-slate-900/90 border border-purple-900/50 shadow-md\">\n          <div className=\"text-[11px] font-mono text-purple-400 uppercase tracking-wider mb-1 flex items-center gap-1.5\">\n            <Scale className=\"w-4 h-4 text-purple-400\" />\n            <span>Delphi Panel Triangulated Consensus Summary</span>\n          </div>\n          <p className=\"text-xs md:text-sm text-slate-200 leading-relaxed font-sans\">\n            {delphi.consensus_summary}\n          </p>\n        </div>\n      )}\n\n      {/* Expert Briefs Tabs */}\n      <div className=\"bg-slate-900/90 rounded-xl border border-slate-800 overflow-hidden\">\n        <div className=\"p-3 border-b border-slate-800 bg-slate-950/60 flex flex-wrap gap-2\">\n          {delphi.expert_briefs.map((brief, idx) => (\n            <button\n              key={idx}\n              onClick={() => setSelectedExpertIdx(idx)}\n              className={`px-3.5 py-2 rounded-xl text-xs font-mono transition-all flex items-center gap-2 cursor-pointer ${\n                selectedExpertIdx === idx\n                  ? \'bg-purple-950 text-purple-300 border border-purple-700 font-bold\'\n                  : \'bg-slate-900/80 text-slate-400 hover:text-slate-200 border border-slate-800\'\n              }`}\n            >\n              <span className=\"w-5 h-5 rounded-full bg-slate-800 flex items-center justify-center text-[10px]\">\n                {idx + 1}\n              </span>\n              <span className=\"truncate max-w-xs\">{brief.expert_title}</span>\n            </button>\n          ))}\n        </div>\n\n        {/* Selected Expert Deep Audit Brief */}\n        <div className=\"p-5 space-y-4\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800/80 pb-3\">\n            <div>\n              <h4 className=\"text-base font-bold text-white flex items-center gap-2\">\n                <span>{activeBrief.expert_title}</span>\n              </h4>\n              <p className=\"text-xs text-slate-400 mt-0.5\">\n                Focus Domain: {activeBrief.focus_domain}\n              </p>\n            </div>\n            <span className=\"px-2.5 py-1 rounded bg-slate-950 text-xs font-mono text-cyan-400 border border-slate-800 self-start sm:self-auto\">\n              DOMAIN AUDIT DOSSIER\n            </span>\n          </div>\n\n          {/* Domain Critique */}\n          <div className=\"p-3.5 rounded-lg bg-slate-950/80 border border-slate-800\">\n            <div className=\"text-[11px] font-mono text-cyan-400 uppercase tracking-wider mb-1 flex items-center gap-1\">\n              <Zap className=\"w-3.5 h-3.5 text-cyan-400\" />\n              <span>Skeptical Objective Critique</span>\n            </div>\n            <p className=\"text-xs text-slate-300 leading-relaxed\">\n              {activeBrief.domain_critique}\n            </p>\n          </div>\n\n          {/* 4 Quadrants: Bottlenecks, Financial Stress, SPOF, Unhedged */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n            {/* Infrastructure Bottlenecks */}\n            <div className=\"p-3.5 rounded-lg bg-slate-950/60 border border-slate-800/80\">\n              <div className=\"text-[11px] font-mono text-amber-400 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                <Layers className=\"w-3.5 h-3.5 text-amber-400\" />\n                <span>Infrastructure Bottlenecks</span>\n              </div>\n              <ul className=\"space-y-1.5\">\n                {activeBrief.infrastructure_bottlenecks.map((item, i) => (\n                  <li key={i} className=\"text-xs text-slate-300 flex items-start gap-2\">\n                    <span className=\"text-amber-500 font-bold shrink-0 mt-0.5\">&bull;</span>\n                    <span className=\"leading-snug\">{item}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* Financial Stress Points */}\n            <div className=\"p-3.5 rounded-lg bg-slate-950/60 border border-slate-800/80\">\n              <div className=\"text-[11px] font-mono text-emerald-400 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                <TrendingDown className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span>Financial Stress Points</span>\n              </div>\n              <ul className=\"space-y-1.5\">\n                {activeBrief.financial_stress_points.map((item, i) => (\n                  <li key={i} className=\"text-xs text-slate-300 flex items-start gap-2\">\n                    <span className=\"text-emerald-500 font-bold shrink-0 mt-0.5\">&bull;</span>\n                    <span className=\"leading-snug\">{item}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* Single Points of Failure */}\n            <div className=\"p-3.5 rounded-lg bg-rose-950/20 border border-rose-900/40\">\n              <div className=\"text-[11px] font-mono text-rose-300 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                <AlertOctagon className=\"w-3.5 h-3.5 text-rose-400\" />\n                <span>Single-Point-of-Failure Risks</span>\n              </div>\n              <ul className=\"space-y-1.5\">\n                {activeBrief.single_point_of_failure_risks.map((item, i) => (\n                  <li key={i} className=\"text-xs text-rose-200/90 flex items-start gap-2\">\n                    <span className=\"text-rose-400 font-bold shrink-0 mt-0.5\">&bull;</span>\n                    <span className=\"leading-snug\">{item}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* Unhedged Assumptions */}\n            <div className=\"p-3.5 rounded-lg bg-slate-950/60 border border-slate-800/80\">\n              <div className=\"text-[11px] font-mono text-indigo-300 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                <ShieldAlert className=\"w-3.5 h-3.5 text-indigo-400\" />\n                <span>Unhedged Business Assumptions</span>\n              </div>\n              <ul className=\"space-y-1.5\">\n                {activeBrief.unhedged_assumptions.map((item, i) => (\n                  <li key={i} className=\"text-xs text-slate-300 flex items-start gap-2\">\n                    <span className=\"text-indigo-400 font-bold shrink-0 mt-0.5\">&bull;</span>\n                    <span className=\"leading-snug\">{item}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Core Operational Variables Table */}\n      <div className=\"bg-slate-900/90 rounded-xl border border-slate-800 overflow-hidden\">\n        <div className=\"p-3.5 border-b border-slate-800 bg-slate-950/60\">\n          <h4 className=\"text-sm font-bold text-white flex items-center gap-2\">\n            <span>Markdown Table: Core Operational Variables</span>\n            <span className=\"text-xs font-mono text-slate-400 font-normal\">\n              (Triangulated Metrics Matrix)\n            </span>\n          </h4>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-950 text-slate-400 font-mono text-[11px] uppercase border-b border-slate-800\">\n              <tr>\n                <th className=\"px-4 py-2.5\">Variable Name</th>\n                <th className=\"px-4 py-2.5\">Metric & Anchor</th>\n                <th className=\"px-4 py-2.5\">Status</th>\n                <th className=\"px-4 py-2.5\">Governing Expert</th>\n                <th className=\"px-4 py-2.5\">Sensitivity</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60 font-sans\">\n              {delphi.operational_variables.map((opVar, idx) => (\n                <tr key={idx} className=\"hover:bg-slate-800/40 transition-colors\">\n                  <td className=\"px-4 py-2.5 font-semibold text-white\">\n                    {opVar.variable_name}\n                  </td>\n                  <td className=\"px-4 py-2.5 text-slate-300 font-mono text-[11px]\">\n                    {opVar.metric}\n                  </td>\n                  <td className=\"px-4 py-2.5\">\n                    <span\n                      className={`px-2 py-0.5 rounded text-[10px] font-mono ${\n                        opVar.status === \'VERIFIED\'\n                          ? \'bg-emerald-950 text-emerald-300 border border-emerald-800\'\n                          : opVar.status === \'DISPUTED\'\n                          ? \'bg-rose-950 text-rose-300 border border-rose-800 font-bold\'\n                          : opVar.status === \'HIGH_SENSITIVITY\'\n                          ? \'bg-amber-950 text-amber-300 border border-amber-800\'\n                          : \'bg-indigo-950 text-indigo-300 border border-indigo-800\'\n                      }`}\n                    >\n                      {opVar.status}\n                    </span>\n                  </td>\n                  <td className=\"px-4 py-2.5 text-slate-400 text-[11px]\">\n                    {opVar.governing_expert}\n                  </td>\n                  <td className=\"px-4 py-2.5\">\n                    <span\n                      className={`px-2 py-0.5 rounded text-[10px] font-mono ${\n                        opVar.sensitivity === \'FATAL\'\n                          ? \'bg-rose-900/60 text-rose-200 border border-rose-700 font-extrabold animate-pulse\'\n                          : opVar.sensitivity === \'HIGH\'\n                          ? \'bg-amber-950 text-amber-300 border border-amber-800\'\n                          : \'bg-slate-800 text-slate-300\'\n                      }`}\n                    >\n                      {opVar.sensitivity}\n                    </span>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Cross-Domain Blind Spots Matrix */}\n      {delphi.cross_domain_blind_spots && delphi.cross_domain_blind_spots.length > 0 && (\n        <div className=\"bg-slate-900/90 rounded-xl border border-rose-900/50 p-4\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <AlertOctagon className=\"w-4 h-4 text-rose-400\" />\n            <h4 className=\"text-sm font-bold text-white font-mono\">\n              CROSS-DOMAIN BLIND SPOTS (MUTUAL INVALIDATION MATRIX)\n            </h4>\n          </div>\n          <p className=\"text-xs text-slate-400 mb-3\">\n            Scenarios where one expert&apos;s deep-dive findings introduce operational variables that invalidate another expert&apos;s conclusions:\n          </p>\n\n          <div className=\"space-y-3\">\n            {delphi.cross_domain_blind_spots.map((spot, sIdx) => (\n              <div\n                key={sIdx}\n                className=\"p-3 rounded-lg bg-slate-950 border border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-3\"\n              >\n                <div className=\"flex items-center gap-2 text-xs font-mono\">\n                  <span className=\"text-cyan-400 truncate max-w-xs\">{spot.primary_expert}</span>\n                  <ArrowRight className=\"w-3.5 h-3.5 text-slate-500 shrink-0\" />\n                  <span className=\"text-rose-400 truncate max-w-xs\">{spot.challenging_expert}</span>\n                </div>\n\n                <div className=\"flex-1 md:px-4 text-xs text-slate-300\">\n                  <span className=\"font-semibold text-amber-300\">Invalidating Variable: </span>\n                  {spot.invalidating_variable}\n                </div>\n\n                <div className=\"text-xs font-mono text-rose-300/90 bg-rose-950/40 px-2.5 py-1 rounded border border-rose-900/40 shrink-0\">\n                  {spot.strategic_impact}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
