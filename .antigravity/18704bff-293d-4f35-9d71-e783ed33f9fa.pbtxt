  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', system-ui, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n    background-color: #020617;\n    color: #f8fafc;\n  }\n\n  code, pre, .font-mono {\n    font-family: \'JetBrains Mono\', monospace;\n  }\n}\n\n/* Custom Scrollbar for Intelligence Panels */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: #090d16;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #1e293b;\n  border-radius: 3px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #334155;\n}\n\n/* Radar & Signal Animations */\n@keyframes radar-pulse {\n  0% {\n    transform: scale(0.95);\n    opacity: 0.8;\n  }\n  50% {\n    transform: scale(1.08);\n    opacity: 0.3;\n  }\n  100% {\n    transform: scale(0.95);\n    opacity: 0.8;\n  }\n}\n\n.radar-sweep {\n  animation: radar-pulse 3s infinite ease-in-out;\n}\n\n/* Markdown prose styling */\n.report-content h1 {\n  font-size: 1.85rem;\n  font-weight: 800;\n  letter-spacing: -0.025em;\n  color: #f8fafc;\n  margin-top: 1.5rem;\n  margin-bottom: 1rem;\n  border-bottom: 1px solid #1e293b;\n  padding-bottom: 0.5rem;\n}\n\n.report-content h2 {\n  font-size: 1.35rem;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  color: #38bdf8;\n  margin-top: 2rem;\n  margin-bottom: 0.75rem;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.report-content h3 {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: #e2e8f0;\n  margin-top: 1.25rem;\n  margin-bottom: 0.5rem;\n}\n\n.report-content p {\n  color: #cbd5e1;\n  line-height: 1.7;\n  margin-bottom: 1rem;\n}\n\n.report-content ul, .report-content ol {\n  margin-bottom: 1rem;\n  padding-left: 1.5rem;\n  color: #cbd5e1;\n}\n\n.report-content ul {\n  list-style-type: square;\n}\n\n.report-content li {\n  margin-bottom: 0.4rem;\n  line-height: 1.6;\n}\n\n.report-content table {\n  width: 100%;\n  border-collapse: separate;\n  border-spacing: 0;\n  margin: 1.5rem 0;\n  border-radius: 0.5rem;\n  overflow: hidden;\n  border: 1px solid #1e293b;\n  font-size: 0.875rem;\n}\n\n.report-content th {\n  background-color: #0f172a;\n  color: #94a3b8;\n  font-weight: 600;\n  text-align: left;\n  padding: 0.75rem 1rem;\n  border-bottom: 1px solid #1e293b;\n  text-transform: uppercase;\n  font-size: 0.75rem;\n  letter-spacing: 0.05em;\n}\n\n.report-content td {\n  padding: 0.75rem 1rem;\n  border-bottom: 1px solid #1e293b;\n  color: #e2e8f0;\n}\n\n.report-content tr:last-child td {\n  border-bottom: none;\n}\n\n.report-content tr:nth-child(even) {\n  background-color: rgba(15, 23, 42, 0.4);\n}\n\n.report-content blockquote {\n  border-left: 3px solid #38bdf8;\n  padding-left: 1rem;\n  margin: 1rem 0;\n  color: #94a3b8;\n  font-style: italic;\n}\n\n.report-content hr {\n  border: 0;\n  height: 1px;\n  background: #1e293b;\n  margin: 2rem 0;\n}\n\n.report-content strong {\n  color: #f1f5f9;\n  font-weight: 700;\n}\n\n.report-content a {\n  color: #38bdf8;\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n"
    }
