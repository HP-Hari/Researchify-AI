  file_change {
    absolute_path_uri: "file:///src/components/Phase2ToTView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { GitFork, Search, CornerDownRight, ArrowUpRight, ShieldCheck, Tag } from \'lucide-react\';\nimport type { ToTTree } from \'../types\';\n\ninterface Phase2ToTViewProps {\n  totTree?: ToTTree;\n  onNextPhase?: () => void;\n}\n\nexport const Phase2ToTView: React.FC<Phase2ToTViewProps> = ({ totTree, onNextPhase }) => {\n  const [selectedExpert, setSelectedExpert] = useState<string | null>(null);\n\n  if (!totTree || Object.keys(totTree).length === 0) {\n    return (\n      <div className=\"p-8 text-center bg-slate-900/40 rounded-2xl border border-slate-800 text-slate-400\">\n        <GitFork className=\"w-10 h-10 mx-auto text-slate-600 mb-3 animate-pulse\" />\n        <p className=\"text-sm font-mono\">ToT Router initializing... Constructing asymmetric query trees.</p>\n      </div>\n    );\n  }\n\n  const expertTitles = Object.keys(totTree);\n  const activeExpert = selectedExpert || expertTitles[0];\n  const tracks = totTree[activeExpert] || {};\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-slate-900/80 border border-slate-800\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-2 py-0.5 rounded text-[10px] font-mono bg-indigo-950 text-indigo-400 border border-indigo-800\">\n              PHASE 2 : ToT ROUTER\n            </span>\n            <span className=\"text-xs font-mono text-cyan-400 flex items-center gap-1\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-cyan-400\"></span>\n              Multi-Parameter Geo-Anchored Branches\n            </span>\n          </div>\n          <h3 className=\"text-lg font-bold text-white mt-1\">\n            Asymmetric Tree-of-Thought (ToT) Queries Router\n          </h3>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Expands each expert mandate into 3 root tracks with multi-parameter web search strings and nested leaf queries.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n          <span className=\"px-3 py-1 rounded-lg bg-slate-950 text-xs font-mono text-slate-300 border border-slate-800 flex items-center gap-1.5\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span>Schema Compliant</span>\n          </span>\n          {onNextPhase && (\n            <button\n              onClick={onNextPhase}\n              className=\"px-3 py-1 rounded-lg bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-300 text-xs font-mono border border-indigo-500/40 cursor-pointer\"\n            >\n              Advance to MapReduce Grid &rarr;\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Expert Tabs */}\n      <div className=\"flex flex-wrap gap-2 border-b border-slate-800 pb-3\">\n        {expertTitles.map((title, idx) => (\n          <button\n            key={idx}\n            onClick={() => setSelectedExpert(title)}\n            className={`px-3.5 py-2 rounded-xl text-xs font-mono transition-all flex items-center gap-2 cursor-pointer ${\n              activeExpert === title\n                ? \'bg-indigo-950/80 text-indigo-300 border border-indigo-700/80 shadow-md shadow-indigo-950\'\n                : \'bg-slate-900/60 text-slate-400 hover:text-slate-200 border border-slate-800\'\n            }`}\n          >\n            <span className=\"w-5 h-5 rounded-full bg-slate-800 flex items-center justify-center text-[10px]\">\n              {idx + 1}\n            </span>\n            <span className=\"truncate max-w-xs\">{title}</span>\n          </button>\n        ))}\n      </div>\n\n      {/* Root Tracks Grid for Active Expert */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        {Object.entries(tracks).map(([trackKey, trackData], tIdx) => (\n          <div\n            key={tIdx}\n            className=\"flex flex-col justify-between p-4 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-indigo-500/40 transition-all shadow-md\"\n          >\n            <div>\n              {/* Track Title & Operational Boundary */}\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"px-2 py-0.5 rounded text-[10px] font-mono bg-indigo-950 text-indigo-300 border border-indigo-800\">\n                  {trackKey.toUpperCase()}\n                </span>\n                <span className=\"text-[10px] font-mono text-slate-500\">\n                  Track {tIdx + 1}/3\n                </span>\n              </div>\n\n              <div className=\"mb-3 p-2 rounded bg-slate-950 border border-slate-800/80\">\n                <div className=\"text-[10px] font-mono text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1\">\n                  <Tag className=\"w-3 h-3 text-indigo-400\" />\n                  <span>Operational Boundary</span>\n                </div>\n                <p className=\"text-xs text-slate-200 leading-relaxed font-sans\">\n                  {trackData.focus}\n                </p>\n              </div>\n\n              {/* Primary Queries */}\n              <div className=\"space-y-2 mt-3\">\n                <div className=\"text-[10px] font-mono text-cyan-400 uppercase tracking-wider flex items-center gap-1\">\n                  <Search className=\"w-3 h-3 text-cyan-400\" />\n                  <span>Multi-Parameter Primary Strings</span>\n                </div>\n\n                {trackData.primary_queries.map((queryStr, qIdx) => (\n                  <div\n                    key={qIdx}\n                    className=\"p-2.5 rounded bg-slate-950/80 border border-slate-800/60 text-xs font-mono text-slate-300 flex items-start gap-2 hover:border-slate-700 transition-colors\"\n                  >\n                    <ArrowUpRight className=\"w-3.5 h-3.5 text-cyan-400 shrink-0 mt-0.5\" />\n                    <span className=\"leading-snug\">{queryStr}</span>\n                  </div>\n                ))}\n              </div>\n\n              {/* Nested Leaf Queries */}\n              {trackData.leaf_queries && trackData.leaf_queries.length > 0 && (\n                <div className=\"mt-3 pt-3 border-t border-slate-800/60\">\n                  <div className=\"text-[10px] font-mono text-amber-400 uppercase tracking-wider flex items-center gap-1 mb-1.5\">\n                    <CornerDownRight className=\"w-3 h-3 text-amber-400\" />\n                    <span>Spawned Leaf Query (Disputed Filings Anchor)</span>\n                  </div>\n                  {trackData.leaf_queries.map((lq, lIdx) => (\n                    <div\n                      key={lIdx}\n                      className=\"p-2 rounded bg-amber-950/20 border border-amber-900/40 text-[11px] font-mono text-amber-300/90 leading-tight\"\n                    >\n                      {lq}\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
    }
