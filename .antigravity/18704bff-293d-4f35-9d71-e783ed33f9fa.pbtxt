ion/json\" },     body: JSON.stringify({ phase: 5, query: q, personas: p1.data, mapReduce: p3.data, delphi: p4.data })   }).then(r => r.json());   console.log(\"Phase 5 adjudicated claims:\", p5.data?.adjudicated_claims?.length, \"Certainty:\", p5.data?.overall_epistemic_certainty);    console.log(\"Running Phase 6...\");   const p6 = await fetch(\"http://localhost:3000/api/pipeline/step\", {     method: \"POST\",     headers: { \"Content-Type\": \"application/json\" },     body: JSON.stringify({ phase: 6, query: q, personas: p1.data, mapReduce: p3.data, delphi: p4.data, adversarial: p5.data })   }).then(r => r.json());   console.log(\"Phase 6 verdict:\", p6.data?.investment_verdict, \"Report length:\", p6.data?.markdown_report?.length, \"Sources:\", p6.data?.sources?.length);   console.log(\"\\nALL PHASES EXECUTED SUCCESSFULLY WITH ZERO ERRORS!\"); } testAllPhases(); \' |\n\n</details>"
