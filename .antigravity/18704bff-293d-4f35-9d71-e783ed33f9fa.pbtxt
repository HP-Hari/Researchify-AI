  file_change {
    absolute_path_uri: "file:///src/components/PresetsModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { X, Sparkles, ArrowRight, ShieldCheck, Zap } from \'lucide-react\';\n\ninterface Preset {\n  id: string;\n  title: string;\n  query: string;\n  industry: string;\n  geo: string;\n}\n\ninterface PresetsModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  presets: Preset[];\n  onSelectPreset: (query: string) => void;\n}\n\nexport const PresetsModal: React.FC<PresetsModalProps> = ({\n  isOpen,\n  onClose,\n  presets,\n  onSelectPreset,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md\">\n      <div className=\"w-full max-w-2xl bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between p-4 border-b border-slate-800 bg-slate-950/60\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-cyan-400\" />\n            <h3 className=\"text-base font-bold text-white font-mono\">\n              HIGH-CONVICTION BENCHMARK PROPOSITIONS\n            </h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-4 overflow-y-auto space-y-3\">\n          <p className=\"text-xs text-slate-400 font-sans mb-3\">\n            Select an unformatted high-stakes global business proposition to launch through Researchify AI&apos;s isolated nodes, tree-of-thought routing, and adversarial debate:\n          </p>\n\n          {presets.map((preset) => (\n            <div\n              key={preset.id}\n              onClick={() => {\n                onSelectPreset(preset.query);\n                onClose();\n              }}\n              className=\"p-4 rounded-xl bg-slate-950/70 border border-slate-800 hover:border-cyan-500/50 hover:bg-slate-950 transition-all cursor-pointer group\"\n            >\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <span className=\"text-[11px] font-mono text-cyan-400 bg-cyan-950/40 px-2 py-0.5 rounded border border-cyan-800/40\">\n                  {preset.industry}\n                </span>\n                <span className=\"text-[11px] font-mono text-slate-500\">\n                  Region: {preset.geo}\n                </span>\n              </div>\n\n              <h4 className=\"text-sm font-bold text-slate-100 group-hover:text-cyan-300 transition-colors\">\n                {preset.title}\n              </h4>\n\n              <p className=\"text-xs text-slate-400 mt-1 leading-relaxed\">\n                {preset.query}\n              </p>\n\n              <div className=\"mt-3 flex items-center justify-between pt-2 border-t border-slate-800/60 text-[11px] font-mono text-slate-500\">\n                <span className=\"flex items-center gap-1 text-emerald-400/80\">\n                  <ShieldCheck className=\"w-3.5 h-3.5\" />\n                  <span>Calibrated Stress Test Ready</span>\n                </span>\n                <span className=\"flex items-center gap-1 text-cyan-400 group-hover:translate-x-0.5 transition-transform font-semibold\">\n                  <span>Load Into Grid</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
