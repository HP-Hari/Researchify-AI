    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  Swords,\n  TrendingUp,\n  ShieldAlert,\n  Gavel,\n  CheckCircle,\n  AlertTriangle,\n  Flame,\n  Percent,\n} from \'lucide-react\';\nimport type { AdversarialOutput } from \'../types\';\n\ninterface Phase5AdversarialViewProps {\n  adversarial?: AdversarialOutput;\n  onNextPhase?: () => void;\n}\n\nexport const Phase5AdversarialView: React.FC<Phase5AdversarialViewProps> = ({\n  adversarial,\n  onNextPhase,\n}) => {\n  if (!adversarial || !adversarial.debate_transcript || adversarial.debate_transcript.length === 0) {\n    return (\n      <div className=\"p-8 text-center bg-slate-900/40 rounded-2xl border border-slate-800 text-slate-400\">\n        <Swords className=\"w-10 h-10 mx-auto text-slate-600 mb-3 animate-pulse\" />\n        <p className=\"text-sm font-mono\">Bi-Directional Adversarial Debate (BAC) in session... Stress-testing contradictions.</p>\n      </div>\n    );\n  }\n\n  const { debate_transcript, adjudicated_claims, overall_epistemic_certainty, decision_posture } =\n    adversarial;\n\n  const isNoGo = decision_posture === \'NO_GO\';\n  const isConditional = decision_posture === \'CONDITIONAL_GO\';\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-slate-900/80 border border-slate-800\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-2 py-0.5 rounded text-[10px] font-mono bg-rose-950 text-rose-400 border border-rose-800\">\n              PHASE 5 : BAC LOOP & ADJUDICATION\n            </span>\n            <span className=\"text-xs font-mono text-amber-400 flex items-center gap-1\">\n              <Flame className=\"w-3.5 h-3.5 text-amber-400\" />\n              Contradiction Isolation Directive Enforced\n            </span>\n          </div>\n          <h3 className=\"text-lg font-bold text-white mt-1\">\n            Bi-Directional Adversarial Debate & Epistemic Certainty Adjudication\n          </h3>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Expansion Visionary vs Cynical Risk Auditor cross-examining flagged data collisions across 2 battle rounds, adjudicated by the mathematical certainty judge.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n          {onNextPhase && (\n            <button\n              onClick={onNextPhase}\n              className=\"px-3 py-1 rounded-lg bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 text-xs font-mono border border-rose-500/40 cursor-pointer\"\n            >\n              Advance to Master Compiler &rarr;\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Adjudication Judge Scoreboard */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        {/* Decision Posture */}\n        <div className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-800 flex flex-col justify-between\">\n          <div className=\"text-[11px] font-mono text-slate-400 flex items-center gap-1.5 mb-2\">\n            <Gavel className=\"w-4 h-4 text-cyan-400\" />\n            <span>ADJUDICATED VENTURE POSTURE</span>\n          </div>\n          <div className=\"my-2\">\n            <span\n              className={`text-2xl font-black font-mono tracking-wider px-3 py-1 rounded-lg inline-block ${\n                isNoGo\n                  ? \'bg-rose-950 text-rose-300 border border-rose-800\'\n                  : isConditional\n                  ? \'bg-amber-950 text-amber-300 border border-amber-800\'\n                  : \'bg-emerald-950 text-emerald-300 border border-emerald-800\'\n              }`}\n            >\n              {decision_posture.replace(\'_\', \' \')}\n            </span>\n          </div>\n          <p className=\"text-[11px] text-slate-400 font-sans\">\n            {isNoGo\n              ? \'Fatal unhedged liabilities or insurmountable bottlenecks identified.\'\n              : isConditional\n              ? \'Viable thesis strictly contingent upon explicit de-risking covenants.\'\n              : \'High mathematical certainty with resilient empirical margins.\'}\n          </p>\n        </div>\n\n        {/* Epistemic Certainty Percentage */}\n        <div className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-800 flex flex-col justify-between\">\n          <div className=\"text-[11px] font-mono text-slate-400 flex items-center gap-1.5 mb-2\">\n            <Percent className=\"w-4 h-4 text-emerald-400\" />\n            <span>OVERALL EPISTEMIC CERTAINTY</span>\n          </div>\n          <div>\n            <div className=\"flex items-baseline gap-2\">\n              <span className=\"text-4xl font-extrabold font-mono text-white\">\n                {overall_epistemic_certainty}%\n              </span>\n              <span className=\"text-xs font-mono text-slate-400\">\n                Resilience Index\n              </span>\n            </div>\n            {/* Progress bar */}\n            <div className=\"w-full bg-slate-950 h-2.5 rounded-full overflow-hidden border border-slate-800 mt-2\">\n              <div\n                className={`h-full rounded-full transition-all duration-500 ${\n                  overall_epistemic_certainty >= 75\n                    ? \'bg-emerald-400\'\n                    : overall_epistemic_certainty >= 50\n                    ? \'bg-amber-400\'\n                    : \'bg-rose-500\'\n                }`}\n                style={{ width: `${overall_epistemic_certainty}%` }}\n              />\n            </div>\n          </div>\n          <div className=\"text-[10px] font-mono text-slate-500 mt-2\">\n            Calculated via Adversarial Debate tie-breaking matrices\n          </div>\n        </div>\n\n        {/* Contested Claims Count */}\n        <div className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-800 flex flex-col justify-between\">\n          <div className=\"text-[11px] font-mono text-slate-400 flex items-center gap-1.5 mb-2\">\n            <Swords className=\"w-4 h-4 text-rose-400\" />\n            <span>CROSS-EXAMINED CLAIMS</span>\n          </div>\n          <div>\n            <div className=\"text-3xl font-extrabold font-mono text-white\">\n              {adjudicated_claims.length}\n            </div>\n            <div className=\"text-xs text-slate-400 mt-1\">\n              Active operational claims stressed in 2 debate rounds\n            </div>\n          </div>\n          <div className=\"text-[10px] font-mono text-cyan-400 mt-2\">\n            Protocol 2: Collisions Isolated in Round 1\n          </div>\n        </div>\n      </div>\n\n      {/* 2-Round Debate Transcript */}\n      <div className=\"bg-slate-900/90 rounded-xl border border-slate-800 p-5 space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n          <div className=\"flex items-center gap-2\">\n            <Swords className=\"w-4 h-4 text-cyan-400\" />\n            <h4 className=\"text-sm font-bold text-white font-mono\">\n              BI-DIRECTIONAL ADVERSARIAL DEBATE TRANSCRIPT (BAC LOG)\n            </h4>\n          </div>\n          <span className=\"text-xs font-mono text-slate-400\">\n            2 Rounds of Cross-Examination\n          </span>\n        </div>\n\n        <div className=\"space-y-4\">\n          {debate_transcript.map((turn, tIdx) => {\n            const isVisionary = turn.speaker === \'EXPANSION_VISIONARY\';\n            return (\n              <div\n                key={tIdx}\n                className={`p-4 rounded-xl border transition-all ${\n                  isVisionary\n                    ? \'bg-cyan-950/20 border-cyan-900/50 ml-0 mr-4 md:mr-12\'\n                    : \'bg-rose-950/20 border-rose-900/50 ml-4 md:ml-12 mr-0\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between mb-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <span\n                      className={`px-2 py-0.5 rounded text-[10px] font-mono font-bold flex items-center gap-1 ${\n                        isVisionary\n                          ? \'bg-cyan-950 text-cyan-300 border border-cyan-800\'\n                          : \'bg-rose-950 text-rose-300 border border-rose-800\'\n                      }`}\n                    >\n                      {isVisionary ? (\n                        <>\n                          <TrendingUp className=\"w-3 h-3 text-cyan-400\" />\n                          <span>EXPANSION VISIONARY (OPTIMIST)</span>\n                        </>\n                      ) : (\n                        <>\n                          <ShieldAlert className=\"w-3 h-3 text-rose-400\" />\n                          <span>CYNICAL RISK AUDITOR (PESSIMIST)</span>\n                        </>\n                      )}\n                    </span>\n                    <span className=\"text-[11px] font-mono text-slate-500\">\n                      Round {turn.round}\n                    </span>\n                  </div>\n\n                  {turn.vulnerability_targeted && (\n                    <span className=\"text-[10px] font-mono text-amber-400/90 bg-amber-950/30 px-2 py-0.5 rounded border border-amber-900/40\">\n                      Target: {turn.vulnerability_targeted}\n                    </span>\n                  )}\n                </div>\n\n                <p className=\"text-xs md:text-sm text-slate-200 leading-relaxed font-sans\">\n                  {turn.argument}\n                </p>\n\n                {turn.cited_fact_ids && turn.cited_fact_ids.length > 0 && (\n                  <div className=\"mt-2.5 pt-2 border-t border-slate-800/60 flex items-center gap-1.5 text-[11px] font-mono text-slate-400\">\n                    <span>Cited MapReduce Fact Anchors:</span>\n                    {turn.cited_fact_ids.map((fid) => (\n                      <span\n                        key={fid}\n                        className=\"px-1.5 py-0.2 rounded bg-slate-950 text-cyan-400 border border-slate-800 text-[10px]\"\n                      >\n                        {fid}\n                      </span>\n                    ))}\n                  </div>\n                )}\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Adjudicated Claims Certainty Matrix */}\n      <div className=\"bg-slate-900/90 rounded-xl border border-slate-800 p-5 space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n          <div className=\"flex items-center gap-2\">\n            <Gavel className=\"w-4 h-4 text-emerald-400\" />\n            <h4 className=\"text-sm font-bold text-white font-mono\">\n              STRICT ADJUDICATION CERTAINTY MATRIX\n            </h4>\n          </div>\n          <span className=\"text-xs font-mono text-emerald-400\">\n            Adversarial Judge Verdicts\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 gap-3\">\n          {adjudicated_claims.map((claim) => (\n            <div\n              key={claim.claim_id}\n              className=\"p-4 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition-colors\"\n            >\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"font-mono text-xs font-bold text-cyan-400\">\n                    {claim.claim_id}\n                  </span>\n                  <span\n                    className={`px-2 py-0.5 rounded text-[10px] font-mono ${\n                      claim.risk_status === \'HIGH_CERTAINTY_VERIFIED\'\n                        ? \'bg-emerald-950 text-emerald-300 border border-emerald-800\'\n                        : claim.risk_status === \'DISPUTED_OPERATIONAL_VARIABLE\'\n                        ? \'bg-amber-950 text-amber-300 border border-amber-800\'\n                        : \'bg-rose-950 text-rose-300 border border-rose-800 font-bold\'\n                    }`}\n                  >\n                    {claim.risk_status}\n                  </span>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-xs font-mono text-slate-400\">Certainty:</span>\n                  <span className=\"text-xs font-mono font-bold text-emerald-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800\">\n                    {claim.epistemic_certainty_percentage}%\n                  </span>\n                </div>\n              </div>\n\n              {/* Contested Assertion */}\n              <h5 className=\"text-sm font-semibold text-white mb-2\">\n                {claim.target_assertion}\n              </h5>\n\n              {/* Pro vs Con summaries */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-2 text-xs mb-3\">\n                <div className=\"p-2.5 rounded bg-cyan-950/20 border border-cyan-900/40 text-slate-300\">\n                  <span className=\"font-mono text-[10px] text-cyan-400 uppercase block mb-0.5\">\n                    Visionary Defense:\n                  </span>\n                  {claim.pro_argument_summary}\n                </div>\n                <div className=\"p-2.5 rounded bg-rose-950/20 border border-rose-900/40 text-slate-300\">\n                  <span className=\"font-mono text-[10px] text-rose-400 uppercase block mb-0.5\">\n                    Auditor Vulnerability:\n                  </span>\n                  {claim.con_argument_summary}\n                </div>\n              </div>\n\n              {/* Verdict Justification */}\n              <div className=\"p-2.5 rounded bg-slate-900 border border-slate-800 text-xs text-slate-300 font-mono\">\n                <span className=\"text-emerald-400 font-semibold\">Judge Verdict: </span>\n                {claim.verdict_justification}\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
