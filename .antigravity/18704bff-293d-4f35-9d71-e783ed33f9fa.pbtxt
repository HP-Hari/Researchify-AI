the Grid: A Battery of Choi...[8] [PEER_REVIEWED_RESEARCH] Advanced Energy Materials: \"Sodium\342\200\220Ion Batteries Paving the Way for Grid Energy Storage\"    URL: https://doi.org/10.1002/aenm.202001274    Snippet: Peer-reviewed study published in Advanced Energy Materials: \"Sodium\342\200\220Ion Batteries Paving the Way for..."
    }
    command_line: "node -e \'\nasync function testHarvest() {\n  const query = \"Capital deployment and operational viability of 100MW/400MWh Sodium-Ion Battery Energy Storage Systems in ERCOT\";\n  \n  const subqueries = [\n    query,\n    \"Sodium-ion battery energy storage grid LCOE CAPEX\",\n    \"ERCOT battery storage rules interconnection queue\",\n    \"Sodium-ion degradation cycle life temperature battery\"\n  ];\n  \n  const sources = [];\n  const seen = new Set();\n  const add = (s) => {\n    if (s.url && !seen.has(s.url)) {\n      seen.add(s.url);\n      sources.push(s);\n    }\n  };\n\n  await Promise.allSettled(subqueries.map(async (sq) => {\n    const qClean = sq.replace(/[^\\w\\s-]/gi, \" \").split(/\\s+/).slice(0, 5).join(\" \");\n    \n    // OpenAlex\n    try {\n      const res = await fetch(`https://api.openalex.org/works?search=${encodeURIComponent(qClean)}&per-page=3`);\n      const data = await res.json();\n      data.results?.forEach(r => {\n        const url = r.doi || r.primary_location?.landing_page_url;\n        if (url) {\n          add({\n            title: r.title,\n            url,\n            publisher: r.primary_location?.source?.display_name || \"Peer-Reviewed Scientific Journal\",\n            date: String(r.publication_year || \"2025\"),\n            sourceType: \"PEER_REVIEWED_RESEARCH\",\n            snippet: `Peer-reviewed study published in ${r.primary_location?.source?.display_name || \"Journal\"}: \"${r.title}\".`\n          });\n        }\n      });\n    } catch(e) {}\n\n    // Wikipedia\n    try {\n      const res = await fetch(`https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(qClean)}&format=json&origin=*`);\n      const data = await res.json();\n      data.query?.search?.slice(0, 2).forEach(s => {\n        add({\n          title: s.title,\n          url: `https://en.wikipedia.org/wiki/${encodeURIComponent(s.title.replace(/ /g, \"_\"))}`,\n          publisher: \"Wikipedia Institutional Knowledge\",\n          date: \"Live Knowledge Base\",\n          sourceType: \"ENCYCLOPEDIC_REGISTRY\",\n          snippet: s.snippet?.replace(/<[^>]+>/g, \"\")\n        });\n      });\n    } catch(e) {}\n\n    // HackerNews\n    try {\n      const res = await fetch(`https://hn.algolia.com/api/v1/search?query=${encodeURIComponent(qClean)}&tags=story&hitsPerPage=2`);\n      const data = await res.json();\n      data.hits?.forEach(h => {\n        if (h.url && h.title) {\n          let pub = \"Web Media\";\n          try { pub = new URL(h.url).hostname.replace(/^www\\./, \"\"); } catch(e){}\n          add({\n            title: h.title,\n            url: h.url,\n            publisher: pub,\n            date: h.created_at ? h.created_at.slice(0, 10) : \"2025\",\n            sourceType: \"LIVE_NEWS_DISPATCH\",\n            snippet: `Industry news dispatch via ${pub}: \"${h.title}\".`\n          });\n        }\n      });\n    } catch(e) {}\n\n    // Google News RSS\n    try {\n      const res = await fetch(`https://news.google.com/rss/search?q=${encodeURIComponent(qClean)}&hl=en-US&gl=US&ceid=US:en`, {\n        headers: { \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64)\" }\n      });\n      const xml = await res.text();\n      const itemRegex = /<item>[\\s\\S]*?<title>([\\s\\S]*?)<\\/title>[\\s\\S]*?<link>([\\s\\S]*?)<\\/link>[\\s\\S]*?<pubDate>([\\s\\S]*?)<\\/pubDate>[\\s\\S]*?<source url=\\\"([^\\\"]+)\\\">([\\s\\S]*?)<\\/source>/g;\n      let m;\n      let count = 0;\n      while ((m = itemRegex.exec(xml)) !== null && count < 2) {\n        const title = m[1].replace(/&amp;/g, \"&\").replace(/&#39;/g, \"\\x27\").replace(/&quot;/g, \"\\\"\");\n        const link = m[2];\n        const pubDate = m[3] ? new Date(m[3]).toISOString().slice(0, 10) : \"2025\";\n        const pubName = m[5] || \"News Wire\";\n        add({\n          title,\n          url: link,\n          publisher: pubName,\n          date: pubDate,\n          sourceType: \"LIVE_NEWS_DISPATCH\",\n          snippet: `Live market dispatch: \"${title}\" published by ${pubName}.`\n        });\n        count++;\n      }\n    } catch(e) {}\n  }));\n\n  console.log(\"Total unique real internet sources:\", sources.length);\n  console.log(\"Sample sources:\");\n  sources.slice(0, 8).forEach((s, idx) => {\n    console.log(`[${idx+1}] [${s.sourceType}] ${s.publisher}: \"${s.title}\"`);\n    console.log(`    URL: ${s.url}`);\n    console.log(`    Snippet: ${s.snippet?.slice(0, 100)}...`);\n  });\n}\ntestHarvest();\n\'"
    proposed_command_line: "node -e \'\nasync function testHarvest() {\n  const query = \"Capital deployment and operational viability of 100MW/400MWh Sodium-Ion Battery Energy Storage Systems in ERCOT\";\n  \n  const subqueries = [\n    query,\n    \"Sodium-ion battery energy storage grid LCOE CAPEX\",\n    \"ERCOT battery storage rules interconnection queue\",\n    \"Sodium-ion degradation cycle life temperature battery\"\n  ];\n  \n  const sources = [];\n  const seen = new Set();\n  const add = (s) => {\n    if (s.url && !seen.has(s.url)) {\n      seen.add(s.url);\n      sources.push(s);\n    }\n  };\n\n  await Promise.allSettled(subqueries.map(async (sq) => {\n    const qClean = sq.replace(/[^\\w\\s-]/gi, \" \").split(/\\s+/).slice(0, 5).join(\" \");\n    \n    // OpenAlex\n    try {\n      const res = await fetch(`https://api.openalex.org/works?search=${encodeURIComponent(qClean)}&per-page=3`);\n      const data = await res.json();\n      data.results?.forEach(r => {\n        const url = r.doi || r.primary_location?.landing_page_url;\n        if (url) {\n          add({\n            title: r.title,\n            url,\n            publisher: r.primary_location?.source?.display_name || \"Peer-Reviewed Scientific Journal\",\n            date: String(r.publication_year || \"2025\"),\n            sourceType: \"PEER_REVIEWED_RESEARCH\",\n            snippet: `Peer-reviewed study published in ${r.primary_location?.source?.display_name || \"Journal\"}: \"${r.title}\".`\n          });\n        }\n      });\n    } catch(e) {}\n\n    // Wikipedia\n    try {\n      const res = await fetch(`https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(qClean)}&format=json&origin=*`);\n      const data = await res.json();\n      data.query?.search?.slice(0, 2).forEach(s => {\n        add({\n          title: s.title,\n          url: `https://en.wikipedia.org/wiki/${encodeURIComponent(s.title.replace(/ /g, \"_\"))}`,\n          publisher: \"Wikipedia Institutional Knowledge\",\n          date: \"Live Knowledge Base\",\n          sourceType: \"ENCYCLOPEDIC_REGISTRY\",\n          snippet: s.snippet?.replace(/<[^>]+>/g, \"\")\n        });\n      });\n    } catch(e) {}\n\n    // HackerNews\n    try {\n      const res = await fetch(`https://hn.algolia.com/api/v1/search?query=${encodeURIComponent(qClean)}&tags=story&hitsPerPage=2`);\n      const data = await res.json();\n      data.hits?.forEach(h => {\n        if (h.url && h.title) {\n          let pub = \"Web Media\";\n          try { pub = new URL(h.url).hostname.replace(/^www\\./, \"\"); } catch(e){}\n          add({\n            title: h.title,\n            url: h.url,\n            publisher: pub,\n            date: h.created_at ? h.created_at.slice(0, 10) : \"2025\",\n            sourceType: \"LIVE_NEWS_DISPATCH\",\n            snippet: `Industry news dispatch via ${pub}: \"${h.title}\".`\n          });\n        }\n      });\n    } catch(e) {}\n\n    // Google News RSS\n    try {\n      const res = await fetch(`https://news.google.com/rss/search?q=${encodeURIComponent(qClean)}&hl=en-US&gl=US&ceid=US:en`, {\n        headers: { \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64)\" }\n      });\n      const xml = await res.text();\n      const itemRegex = /<item>[\\s\\S]*?<title>([\\s\\S]*?)<\\/title>[\\s\\S]*?<link>([\\s\\S]*?)<\\/link>[\\s\\S]*?<pubDate>([\\s\\S]*?)<\\/pubDate>[\\s\\S]*?<source url=\\\"([^\\\"]+)\\\">([\\s\\S]*?)<\\/source>/g;\n      let m;\n      let count = 0;\n      while ((m = itemRegex.exec(xml)) !== null && count < 2) {\n        const title = m[1].replace(/&amp;/g, \"&\").replace(/&#39;/g, \"\\x27\").replace(/&quot;/g, \"\\\"\");\n        const link = m[2];\n        const pubDate = m[3] ? new Date(m[3]).toISOString().slice(0, 10) : \"2025\";\n        const pubName = m[5] || \"News Wire\";\n        add({\n          title,\n          url: link,\n          publisher: pubName,\n          date: pubDate,\n          sourceType: \"LIVE_NEWS_DISPATCH\",\n          snippet: `Live market dispatch: \"${title}\" published by ${pubName}.`\n        });\n        count++;\n      }\n    } catch(e) {}\n  }));\n\n  console.log(\"Total unique real internet sources:\", sources.length);\n  console.log(\"Sample sources:\");\n  sources.slice(0, 8).forEach((s, idx) => {\n    console.log(`[${idx+1}] [${s.sourceType}] ${s.publisher}: \"${s.title}\"`);\n    console.log(`    URL: ${s.url}`);\n    console.log(`    Snippet: ${s.snippet?.slice(0, 100)}...`);\n  });\n}\ntestHarvest();\n\'"
    shell_name: "bash"
  }
}
