    command_line: "node -e \"\nasync function testSources() {\n  // 1. Wikipedia API\n  try {\n    const wiki = await fetch(\'https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=eVTOL+air+taxi+Manhattan&format=json&origin=*\', {\n      headers: { \'User-Agent\': \'ResearchifyAI/1.0\' }\n    });\n    const wj = await wiki.json();\n    console.log(\'Wikipedia count:\', wj.query?.search?.length);\n  } catch (e) { console.log(\'Wiki error:\', e.message); }\n\n  // 2. Hacker News Algolia API (covers tech, startups, energy, regulations, discussions with real URLs!)\n  try {\n    const hn = await fetch(\'https://hn.algolia.com/api/v1/search?query=eVTOL+Manhattan+JFK&hitsPerPage=5\');\n    const hnj = await hn.json();\n    console.log(\'HN Algolia hits:\', hnj.hits?.length, \'Sample URL:\', hnj.hits?.[0]?.url);\n  } catch (e) { console.log(\'HN error:\', e.message); }\n\n  // 3. Arxiv API (academic papers, technical specs, battery tests, engineering)\n  try {\n    const arxiv = await fetch(\'http://export.arxiv.org/api/query?search_query=all:eVTOL+noise&start=0&max_results=3\');\n    const at = await arxiv.text();\n    console.log(\'Arxiv has entry:\', at.includes(\'<entry>\'));\n  } catch (e) { console.log(\'ArXiv error:\', e.message); }\n\n  // 4. CrossRef API (official peer-reviewed papers, journals, DOI links)\n  try {\n    const cr = await fetch(\'https://api.crossref.org/works?query=Sodium-ion+battery+grid+storage&rows=3\', {\n      headers: { \'User-Agent\': \'ResearchifyAI/1.0 (mailto:research@researchify.ai)\' }\n    });\n    const crj = await cr.json();\n    console.log(\'CrossRef count:\', crj.message?.items?.length, \'Sample DOI URL:\', crj.message?.items?.[0]?.URL);\n  } catch (e) { console.log(\'CrossRef error:\', e.message); }\n}\ntestSources();\n\""
    proposed_command_line: "node -e \"\nasync function testSources() {\n  // 1. Wikipedia API\n  try {\n    const wiki = await fetch(\'https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=eVTOL+air+taxi+Manhattan&format=json&origin=*\', {\n      headers: { \'User-Agent\': \'ResearchifyAI/1.0\' }\n    });\n    const wj = await wiki.json();\n    console.log(\'Wikipedia count:\', wj.query?.search?.length);\n  } catch (e) { console.log(\'Wiki error:\', e.message); }\n\n  // 2. Hacker News Algolia API (covers tech, startups, energy, regulations, discussions with real URLs!)\n  try {\n    const hn = await fetch(\'https://hn.algolia.com/api/v1/search?query=eVTOL+Manhattan+JFK&hitsPerPage=5\');\n    const hnj = await hn.json();\n    console.log(\'HN Algolia hits:\', hnj.hits?.length, \'Sample URL:\', hnj.hits?.[0]?.url);\n  } catch (e) { console.log(\'HN error:\', e.message); }\n\n  // 3. Arxiv API (academic papers, technical specs, battery tests, engineering)\n  try {\n    const arxiv = await fetch(\'http://export.arxiv.org/api/query?search_query=all:eVTOL+noise&start=0&max_results=3\');\n    const at = await arxiv.text();\n    console.log(\'Arxiv has entry:\', at.includes(\'<entry>\'));\n  } catch (e) { console.log(\'ArXiv error:\', e.message); }\n\n  // 4. CrossRef API (official peer-reviewed papers, journals, DOI links)\n  try {\n    const cr = await fetch(\'https://api.crossref.org/works?query=Sodium-ion+battery+grid+storage&rows=3\', {\n      headers: { \'User-Agent\': \'ResearchifyAI/1.0 (mailto:research@researchify.ai)\' }\n    });\n    const crj = await cr.json();\n    console.log(\'CrossRef count:\', crj.message?.items?.length, \'Sample DOI URL:\', crj.message?.items?.[0]?.URL);\n  } catch (e) { console.log(\'CrossRef error:\', e.message); }\n}\ntestSources();\n\""
    shell_name: "bash"
  }
