    wait_ms_before_async: 8000
    combined_output {
      full: "Running Phase 1...Phase 1 personas: 3Running Phase 2...Phase 2 tracks: 3Running Phase 3...Phase 3 records: 8 Harvested web sources: 32Running Phase 4..."
    }
    command_line: "node -e \'\nasync function testAllPhases() {\n  const q = \"100MW Sodium-Ion BESS in ERCOT Texas grid\";\n  console.log(\"Running Phase 1...\");\n  const p1 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 1, query: q })\n  }).then(r => r.json());\n  console.log(\"Phase 1 personas:\", p1.data?.length);\n\n  console.log(\"Running Phase 2...\");\n  const p2 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 2, query: q, personas: p1.data })\n  }).then(r => r.json());\n  console.log(\"Phase 2 tracks:\", Object.keys(p2.data || {}).length);\n\n  console.log(\"Running Phase 3...\");\n  const p3 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 3, query: q, personas: p1.data, totTree: p2.data })\n  }).then(r => r.json());\n  console.log(\"Phase 3 records:\", p3.data?.clean_records?.length, \"Harvested web sources:\", p3.data?.raw_harvested_sources?.length);\n\n  console.log(\"Running Phase 4...\");\n  const p4 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 4, query: q, personas: p1.data, mapReduce: p3.data })\n  }).then(r => r.json());\n  console.log(\"Phase 4 briefs:\", p4.data?.expert_briefs?.length);\n\n  console.log(\"Running Phase 5...\");\n  const p5 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 5, query: q, personas: p1.data, mapReduce: p3.data, delphi: p4.data })\n  }).then(r => r.json());\n  console.log(\"Phase 5 adjudicated claims:\", p5.data?.adjudicated_claims?.length, \"Certainty:\", p5.data?.overall_epistemic_certainty);\n\n  console.log(\"Running Phase 6...\");\n  const p6 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 6, query: q, personas: p1.data, mapReduce: p3.data, delphi: p4.data, adversarial: p5.data })\n  }).then(r => r.json());\n  console.log(\"Phase 6 verdict:\", p6.data?.investment_verdict, \"Report length:\", p6.data?.markdown_report?.length, \"Sources:\", p6.data?.sources?.length);\n  console.log(\"\\nALL PHASES EXECUTED SUCCESSFULLY WITH ZERO ERRORS!\");\n}\ntestAllPhases();\n\'"
    proposed_command_line: "node -e \'\nasync function testAllPhases() {\n  const q = \"100MW Sodium-Ion BESS in ERCOT Texas grid\";\n  console.log(\"Running Phase 1...\");\n  const p1 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 1, query: q })\n  }).then(r => r.json());\n  console.log(\"Phase 1 personas:\", p1.data?.length);\n\n  console.log(\"Running Phase 2...\");\n  const p2 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 2, query: q, personas: p1.data })\n  }).then(r => r.json());\n  console.log(\"Phase 2 tracks:\", Object.keys(p2.data || {}).length);\n\n  console.log(\"Running Phase 3...\");\n  const p3 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 3, query: q, personas: p1.data, totTree: p2.data })\n  }).then(r => r.json());\n  console.log(\"Phase 3 records:\", p3.data?.clean_records?.length, \"Harvested web sources:\", p3.data?.raw_harvested_sources?.length);\n\n  console.log(\"Running Phase 4...\");\n  const p4 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 4, query: q, personas: p1.data, mapReduce: p3.data })\n  }).then(r => r.json());\n  console.log(\"Phase 4 briefs:\", p4.data?.expert_briefs?.length);\n\n  console.log(\"Running Phase 5...\");\n  const p5 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 5, query: q, personas: p1.data, mapReduce: p3.data, delphi: p4.data })\n  }).then(r => r.json());\n  console.log(\"Phase 5 adjudicated claims:\", p5.data?.adjudicated_claims?.length, \"Certainty:\", p5.data?.overall_epistemic_certainty);\n\n  console.log(\"Running Phase 6...\");\n  const p6 = await fetch(\"http://localhost:3000/api/pipeline/step\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ phase: 6, query: q, personas: p1.data, mapReduce: p3.data, delphi: p4.data, adversarial: p5.data })\n  }).then(r => r.json());\n  console.log(\"Phase 6 verdict:\", p6.data?.investment_verdict, \"Report length:\", p6.data?.markdown_report?.length, \"Sources:\", p6.data?.sources?.length);\n  console.log(\"\\nALL PHASES EXECUTED SUCCESSFULLY WITH ZERO ERRORS!\");\n}\ntestAllPhases();\n\'"
