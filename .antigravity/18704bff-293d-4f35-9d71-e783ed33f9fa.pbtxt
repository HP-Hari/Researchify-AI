  file_change {
    absolute_path_uri: "file:///src/components/Phase6ReportView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  FileCheck2,\n  Copy,\n  Check,\n  Printer,\n  ExternalLink,\n  ShieldCheck,\n  AlertTriangle,\n  Award,\n  BookOpen,\n} from \'lucide-react\';\nimport { MarkdownRenderer } from \'./MarkdownRenderer\';\nimport type { MasterReportOutput } from \'../types\';\n\ninterface Phase6ReportViewProps {\n  report?: MasterReportOutput;\n}\n\nexport const Phase6ReportView: React.FC<Phase6ReportViewProps> = ({ report }) => {\n  const [copied, setCopied] = useState(false);\n  const [activeTab, setActiveTab] = useState<\'rendered\' | \'raw\' | \'sources\'>(\'rendered\');\n\n  if (!report || !report.markdown_report) {\n    return (\n      <div className=\"p-8 text-center bg-slate-900/40 rounded-2xl border border-slate-800 text-slate-400\">\n        <FileCheck2 className=\"w-10 h-10 mx-auto text-slate-600 mb-3 animate-pulse\" />\n        <p className=\"text-sm font-mono\">Master Compiler assembling 7-part executive investment report...</p>\n      </div>\n    );\n  }\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(report.markdown_report);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const isNoGo = report.investment_verdict === \'NO_GO\';\n  const isConditional = report.investment_verdict === \'CONDITIONAL_GO\';\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-slate-900/80 border border-slate-800\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-950 text-cyan-400 border border-cyan-800\">\n              PHASE 6 : MASTER REPORT COMPILER\n            </span>\n            <span className=\"text-xs font-mono text-emerald-400 flex items-center gap-1\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n              Fully Hyperlinked Investment Dossier\n            </span>\n          </div>\n          <h3 className=\"text-lg font-bold text-white mt-1\">\n            Executive Market Intelligence Master Report\n          </h3>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Definitive venture verdict, cross-examination briefs, BAC log, systematic certainty matrix, and verified citation index.\n          </p>\n        </div>\n\n        {/* Action Buttons */}\n        <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n          <button\n            onClick={handleCopy}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-slate-700 transition-colors cursor-pointer\"\n          >\n            {copied ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5 text-cyan-400\" />}\n            <span>{copied ? \'Copied\' : \'Copy MD\'}</span>\n          </button>\n\n          <button\n            onClick={handlePrint}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-slate-700 transition-colors cursor-pointer\"\n          >\n            <Printer className=\"w-3.5 h-3.5 text-slate-400\" />\n            <span>Print / PDF</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Metric Highlights Strip */}\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n        <div className=\"p-3.5 rounded-xl bg-slate-900 border border-slate-800\">\n          <div className=\"text-[11px] font-mono text-slate-400 flex items-center gap-1.5 mb-1\">\n            <Award className=\"w-3.5 h-3.5 text-cyan-400\" />\n            <span>INVESTMENT DECISION</span>\n          </div>\n          <div\n            className={`text-xl font-black font-mono mt-0.5 ${\n              isNoGo ? \'text-rose-400\' : isConditional ? \'text-amber-400\' : \'text-emerald-400\'\n            }`}\n          >\n            {report.investment_verdict.replace(\'_\', \' \')}\n          </div>\n          <div className=\"text-[10px] font-mono text-slate-500 mt-1\">\n            Adjudicated Consensus\n          </div>\n        </div>\n\n        <div className=\"p-3.5 rounded-xl bg-slate-900 border border-slate-800\">\n          <div className=\"text-[11px] font-mono text-slate-400 flex items-center gap-1.5 mb-1\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span>EPISTEMIC CERTAINTY</span>\n          </div>\n          <div className=\"text-xl font-black font-mono text-white mt-0.5\">\n            {report.certainty_score}%\n          </div>\n          <div className=\"text-[10px] font-mono text-slate-500 mt-1\">\n            Cross-Examination Resilience\n          </div>\n        </div>\n\n        <div className=\"p-3.5 rounded-xl bg-slate-900 border border-slate-800\">\n          <div className=\"text-[11px] font-mono text-slate-400 flex items-center gap-1.5 mb-1\">\n            <AlertTriangle className=\"w-3.5 h-3.5 text-rose-400\" />\n            <span>CRITICAL RISK FACTORS</span>\n          </div>\n          <div className=\"text-xl font-black font-mono text-rose-300 mt-0.5\">\n            {report.critical_risk_count}\n          </div>\n          <div className=\"text-[10px] font-mono text-slate-500 mt-1\">\n            Fatal or Disputed Variables\n          </div>\n        </div>\n\n        <div className=\"p-3.5 rounded-xl bg-slate-900 border border-slate-800\">\n          <div className=\"text-[11px] font-mono text-slate-400 flex items-center gap-1.5 mb-1\">\n            <BookOpen className=\"w-3.5 h-3.5 text-blue-400\" />\n            <span>VERIFIED CITATIONS</span>\n          </div>\n          <div className=\"text-xl font-black font-mono text-blue-400 mt-0.5\">\n            {report.verified_source_count}\n          </div>\n          <div className=\"text-[10px] font-mono text-slate-500 mt-1\">\n            Zero Data Leakage Welded URLs\n          </div>\n        </div>\n      </div>\n\n      {/* Main View Mode Selector (Rendered vs Raw Markdown vs Sources) */}\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 overflow-hidden shadow-2xl\">\n        <div className=\"flex items-center justify-between p-3 border-b border-slate-800 bg-slate-950/70\">\n          <div className=\"flex items-center gap-1\">\n            <button\n              onClick={() => setActiveTab(\'rendered\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-mono transition-colors cursor-pointer ${\n                activeTab === \'rendered\'\n                  ? \'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-bold\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              Executive Report View\n            </button>\n            <button\n              onClick={() => setActiveTab(\'raw\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-mono transition-colors cursor-pointer ${\n                activeTab === \'raw\'\n                  ? \'bg-slate-800 text-white font-bold\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              Raw Markdown\n            </button>\n            <button\n              onClick={() => setActiveTab(\'sources\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-mono transition-colors cursor-pointer ${\n                activeTab === \'sources\'\n                  ? \'bg-blue-500/20 text-blue-300 border border-blue-500/40 font-bold\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              Sources Index ({report.sources.length})\n            </button>\n          </div>\n\n          <span className=\"text-[11px] font-mono text-slate-500 hidden sm:inline\">\n            7-Part Clinical Master Architecture\n          </span>\n        </div>\n\n        {/* Tab Body */}\n        <div className=\"p-6 md:p-8\">\n          {activeTab === \'rendered\' && (\n            <div className=\"max-w-4xl mx-auto\">\n              <MarkdownRenderer content={report.markdown_report} sources={report.sources} />\n            </div>\n          )}\n\n          {activeTab === \'raw\' && (\n            <div className=\"relative\">\n              <pre className=\"p-4 rounded-xl bg-slate-950 text-slate-300 font-mono text-xs overflow-x-auto whitespace-pre-wrap leading-relaxed border border-slate-800\">\n                {report.markdown_report}\n              </pre>\n            </div>\n          )}\n\n          {activeTab === \'sources\' && (\n            <div className=\"space-y-4 max-w-4xl mx-auto\">\n              <div className=\"border-b border-slate-800 pb-3\">\n                <h4 className=\"text-base font-bold text-white font-mono flex items-center gap-2\">\n                  <BookOpen className=\"w-4 h-4 text-cyan-400\" />\n                  <span>Verified Reference Index &amp; Welded Source URLs</span>\n                </h4>\n                <p className=\"text-xs text-slate-400 mt-1\">\n                  Enforces Zero Data Leakage Law: every empirical metric cited in the report corresponds to a verified web filing or empirical dataset anchor.\n                </p>\n              </div>\n\n              <div className=\"space-y-2.5\">\n                {report.sources.map((src) => (\n                  <div\n                    key={src.id}\n                    id={`source-${src.id}`}\n                    className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 hover:border-slate-700 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-2\"\n                  >\n                    <div className=\"flex items-start gap-2.5\">\n                      <span className=\"px-2 py-0.5 rounded bg-cyan-950 text-cyan-400 border border-cyan-800 font-mono text-xs font-bold shrink-0 mt-0.5\">\n                        [^{src.id}]\n                      </span>\n                      <div>\n                        <div className=\"text-xs font-semibold text-slate-200\">\n                          {src.title}\n                        </div>\n                        <div className=\"text-[11px] text-slate-400 mt-0.5\">\n                          Claim anchor: &quot;{src.claim_reference}&quot;\n                        </div>\n                      </div>\n                    </div>\n\n                    <a\n                      href={src.url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded bg-slate-900 hover:bg-slate-800 text-xs font-mono text-cyan-400 hover:text-cyan-300 border border-slate-800 hover:border-cyan-800 transition-colors self-start sm:self-auto shrink-0\"\n                    >\n                      <span className=\"truncate max-w-[180px] md:max-w-[240px]\">{src.url}</span>\n                      <ExternalLink className=\"w-3 h-3\" />\n                    </a>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
