        replacement_content: "  // Collect all real verified sources\n  const sourcesMap = new Map<string, ReportSource>();\n  let sIdx = 1;\n\n  mapReduce.clean_records.forEach((r) => {\n    r.associated_sources.forEach((url, uIdx) => {\n      if (!sourcesMap.has(url)) {\n        const pub = r.source_publishers?.[uIdx] || \'Verified Live Internet Source\';\n        const title = r.source_titles?.[uIdx] || `Live Intelligence Record (${r.extracted_date || \'Current\'})`;\n        const snip = r.source_snippets?.[uIdx] || r.claim;\n\n        sourcesMap.set(url, {\n          id: sIdx++,\n          title: `${title} \342\200\224 ${pub}`,\n          url,\n          claim_reference: r.claim.slice(0, 110) + \'...\',\n          publisher: pub,\n          date: r.extracted_date || \'Current\',\n          snippet: snip,\n          is_live_web: true,\n        });\n      }\n    });\n  });\n\n  if (mapReduce.raw_harvested_sources && Array.isArray(mapReduce.raw_harvested_sources)) {\n    mapReduce.raw_harvested_sources.forEach((item) => {\n      if (!sourcesMap.has(item.url)) {\n        sourcesMap.set(item.url, {\n          id: sIdx++,\n          title: `${item.title} \342\200\224 ${item.publisher}`,\n          url: item.url,\n          claim_reference: item.snippet || item.title,\n          publisher: item.publisher,\n          date: item.date,\n          snippet: item.snippet,\n          is_live_web: true,\n        });\n      }\n    });\n  }\n\n  const verifiedSourcesList = Array.from(sourcesMap.values());"
