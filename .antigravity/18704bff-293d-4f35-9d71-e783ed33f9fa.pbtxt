=\"w-3.5 h-3.5\" />\n                  </div>\n\n                  {completed ? (\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n                  ) : current ? (\n                    <CircleDashed className=\"w-4 h-4 text-cyan-400 animate-spin\" />\n                  ) : canRun && onExecuteStep ? (\n                    <button\n                      type=\"button\"\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onExecuteStep(item.phase);\n                      }}\n                      disabled={isExecutingStep}\n                      className=\"p-1 rounded bg-cyan-500/20 text-cyan-300 hover:bg-cyan-500/30 text-[10px] font-mono flex items-center gap-1 border border-cyan-500/40 cursor-pointer disabled:opacity-50\"\n                    >\n                      <Play className=\"w-2.5 h-2.5 fill-current\" />\n                      <span>Run</span>\n                    </button>\n                  ) : (\n                    <span className=\"text-[10px] font-mono text-slate-600\">\n                      P{item.phase}\n                    </span>\n                  )}\n                </div>\n\n                <div className=\"text-[11px] font-mono text-slate-400 uppercase tracking-wider truncate\">\n                  {item.label}\n                </div>\n                <div className=\"text-xs font-semibold text-slate-200 truncate mt-0.5\">\n                  {item.name}\n                </div>\n              </div>\n            );"
      }
      num_matches: 1
    }
  }
}
