  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Header } from \'./components/Header\';\nimport { QueryInput } from \'./components/QueryInput\';\nimport { NodePipelineTracker } from \'./components/NodePipelineTracker\';\nimport { Phase1DPSView } from \'./components/Phase1DPSView\';\nimport { Phase2ToTView } from \'./components/Phase2ToTView\';\nimport { Phase3MapReduceView } from \'./components/Phase3MapReduceView\';\nimport { Phase4DelphiView } from \'./components/Phase4DelphiView\';\nimport { Phase5AdversarialView } from \'./components/Phase5AdversarialView\';\nimport { Phase6ReportView } from \'./components/Phase6ReportView\';\nimport { PipelineLiveLogs } from \'./components/PipelineLiveLogs\';\nimport { PresetsModal } from \'./components/PresetsModal\';\nimport { AlertCircle, Terminal, Layers, ArrowRight } from \'lucide-react\';\nimport type { ResearchPipelineData } from \'./types\';\n\nconst INITIAL_PIPELINE_DATA: ResearchPipelineData = {\n  id: \'\',\n  timestamp: \'\',\n  query: \'\',\n  status: \'idle\',\n  currentPhase: 0,\n  logs: [],\n};\n\nexport default function App() {\n  const [pipelineData, setPipelineData] = useState<ResearchPipelineData | null>(null);\n  const [activeTab, setActiveTab] = useState<number>(1);\n  const [presets, setPresets] = useState<any[]>([]);\n  const [isPresetsOpen, setIsPresetsOpen] = useState(false);\n  const [isExecutingStep, setIsExecutingStep] = useState(false);\n  const [eventSource, setEventSource] = useState<EventSource | null>(null);\n\n  // Fetch presets on load\n  useEffect(() => {\n    fetch(\'/api/presets\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.presets) setPresets(data.presets);\n      })\n      .catch((err) => console.warn(\'Could not load presets:\', err));\n  }, []);\n\n  // Cleanup eventSource on unmount\n  useEffect(() => {\n    return () => {\n      if (eventSource) {\n        eventSource.close();\n      }\n    };\n  }, [eventSource]);\n\n  // Start Pipeline (Autonomous SSE Stream or Step-by-Step)\n  const handleStartPipeline = (userQuery: string, mode: \'stream\' | \'step\') => {\n    if (eventSource) {\n      eventSource.close();\n    }\n\n    const newPipeline: ResearchPipelineData = {\n      id: `dossier-${Date.now()}`,\n      timestamp: new Date().toISOString(),\n      query: userQuery,\n      status: \'running\',\n      currentPhase: 1,\n      logs: [\n        {\n          timestamp: new Date().toISOString(),\n          phase: 0,\n          message: `Ingesting venture proposition: \"${userQuery.slice(0, 60)}...\"`,\n          type: \'info\',\n        },\n      ],\n    };\n\n    setPipelineData(newPipeline);\n    setActiveTab(1);\n\n    if (mode === \'stream\') {\n      // Launch SSE Autonomous Blitz\n      const es = new EventSource(`/api/pipeline/stream?query=${encodeURIComponent(userQuery)}`);\n      setEventSource(es);\n\n      es.addEventListener(\'pipeline_init\', (e: any) => {\n        const payload = JSON.parse(e.data);\n        setPipelineData((prev) =>\n          prev\n            ? {\n                ...prev,\n                logs: [\n                  ...prev.logs,\n                  {\n                    timestamp: payload.timestamp,\n                    phase: 0,\n                    message: payload.message,\n                    type: \'info\',\n                  },\n                ],\n              }\n            : null\n        );\n      });\n\n      es.addEventListener(\'phase_start\', (e: any) => {\n        const payload = JSON.parse(e.data);\n        setPipelineData((prev) =>\n          prev\n            ? {\n                ...prev,\n                currentPhase: payload.phase,\n                logs: [\n                  ...prev.logs,\n                  {\n                    timestamp: new Date().toISOString(),\n                    phase: payload.phase,\n                    message: `[START] ${payload.name}: ${payload.message}`,\n                    type: \'info\',\n                  },\n                ],\n              }\n            : null\n        );\n        setActiveTab(payload.phase);\n      });\n\n      es.addEventListener(\'phase_complete\', (e: any) => {\n        const payload = JSON.parse(e.data);\n        const phaseNum = payload.phase;\n        const phaseData = payload.data;\n\n        setPipelineData((prev) => {\n          if (!prev) return null;\n          const updated: ResearchPipelineData = {\n            ...prev,\n            logs: [\n              ...prev.logs,\n              {\n                timestamp: new Date().toISOString(),\n                phase: phaseNum,\n                message: `[VERIFIED] ${payload.name} complete. ${payload.message}`,\n                type: \'success\',\n              },\n            ],\n          };\n\n          if (phaseNum === 1) updated.phase1_dps = phaseData;\n          if (phaseNum === 2) updated.phase2_tot = phaseData;\n          if (phaseNum === 3) updated.phase3_mapreduce = phaseData;\n          if (phaseNum === 4) updated.phase4_delphi = phaseData;\n          if (phaseNum === 5) updated.phase5_adversarial = phaseData;\n          if (phaseNum === 6) updated.phase6_report = phaseData;\n\n          return updated;\n        });\n      });\n\n      es.addEventListener(\'pipeline_complete\', (e: any) => {\n        const payload = JSON.parse(e.data);\n        setPipelineData((prev) =>\n          prev\n            ? {\n                ...prev,\n                status: \'completed\',\n                logs: [\n                  ...prev.logs,\n                  {\n                    timestamp: payload.timestamp,\n                    phase: 6,\n                    message: `[EXECUTION FINISHED] Investment Verdict: ${payload.verdict} (Certainty: ${payload.certainty}%). Master Dossier ready.`,\n                    type: \'success\',\n                  },\n                ],\n              }\n            : null\n        );\n        setActiveTab(6);\n        es.close();\n      });\n\n      es.addEventListener(\'pipeline_error\', (e: any) => {\n        const payload = JSON.parse(e.data);\n        setPipelineData((prev) =>\n          prev\n            ? {\n                ...prev,\n                status: \'error\',\n                error: payload.message,\n                logs: [\n                  ...prev.logs,\n                  {\n                    timestamp: new Date().toISOString(),\n                    phase: prev.currentPhase,\n                    message: `[ERROR] Pipeline interrupted: ${payload.message}`,\n                    type: \'alert\',\n                  },\n                ],\n              }\n            : null\n        );\n        es.close();\n      });\n\n      es.onerror = (err) => {\n        console.warn(\'EventSource closed or encountered network edge:\', err);\n        es.close();\n      };\n    } else {\n      // Step-by-Step Cadence: Run Phase 1 immediately\n      handleExecuteStep(1, newPipeline);\n    }\n  };\n\n  // Step-by-Step Execution Handler\n  const handleExecuteStep = async (phaseNum: number, currentPipeline?: ResearchPipelineData) => {\n    const targetPipeline = currentPipeline || pipelineData;\n    if (!targetPipeline || !targetPipeline.query) return;\n\n    setIsExecutingStep(true);\n    setPipelineData((prev) =>\n      prev\n        ? {\n            ...prev,\n            status: \'running\',\n            currentPhase: phaseNum,\n            logs: [\n              ...prev.logs,\n              {\n                timestamp: new Date().toISOString(),\n                phase: phaseNum,\n                message: `Initiating isolated node execution for Phase ${phaseNum}...`,\n                type: \'info\',\n              },\n            ],\n          }\n        : null\n    );\n    setActiveTab(phaseNum);\n\n    try {\n      const res = await fetch(\'/api/pipeline/step\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          phase: phaseNum,\n          query: targetPipeline.query,\n          previousData: targetPipeline,\n        }),\n      });\n\n      const json = await res.json();\n      if (!res.ok) {\n        throw new Error(json.error || `Phase ${phaseNum} failed`);\n      }\n\n      setPipelineData((prev) => {\n        if (!prev) return null;\n        const updated: ResearchPipelineData = {\n          ...prev,\n          status: phaseNum === 6 ? \'completed\' : \'idle\',\n          logs: [\n            ...prev.logs,\n            {\n              timestamp: new Date().toISOString(),\n              phase: phaseNum,\n              message: `[VERIFIED] Phase ${phaseNum} node execution completed successfully.`,\n              type: \'success\',\n            },\n          ],\n        };\n\n        if (phaseNum === 1) updated.phase1_dps = json.data;\n        if (phaseNum === 2) updated.phase2_tot = json.data;\n        if (phaseNum === 3) updated.phase3_mapreduce = json.data;\n        if (phaseNum === 4) updated.phase4_delphi = json.data;\n        if (phaseNum === 5) updated.phase5_adversarial = json.data;\n        if (phaseNum === 6) updated.phase6_report = json.data;\n\n        return updated;\n      });\n    } catch (err: any) {\n      console.error(`Error executing phase ${phaseNum}:`, err);\n      setPipelineData((prev) =>\n        prev\n          ? {\n              ...prev,\n              status: \'error\',\n              error: err.message,\n              logs: [\n                ...prev.logs,\n                {\n                  timestamp: new Date().toISOString(),\n                  phase: phaseNum,\n                  message: `Phase ${phaseNum} error: ${err.message}`,\n                  type: \'alert\',\n                },\n              ],\n            }\n          : null\n      );\n    } finally {\n      setIsExecutingStep(false);\n    }\n  };\n\n  // Export JSON dossier\n  const handleExportJson = () => {\n    if (!pipelineData) return;\n    const blob = new Blob([JSON.stringify(pipelineData, null, 2)], {\n      type: \'application/json\',\n    });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `researchify-dossier-${Date.now()}.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  // Export Markdown report\n  const handleExportMarkdown = () => {\n    if (!pipelineData?.phase6_report?.markdown_report) return;\n    const blob = new Blob([pipelineData.phase6_report.markdown_report], {\n      type: \'text/markdown\',\n    });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `researchify-report-${Date.now()}.md`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleReset = () => {\n    if (eventSource) {\n      eventSource.close();\n    }\n    setPipelineData(null);\n    setActiveTab(1);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-cyan-500/20 selection:text-cyan-200\">\n      {/* Top Header */}\n      <Header\n        pipelineData={pipelineData}\n        onSelectPresetModal={() => setIsPresetsOpen(true)}\n        onReset={handleReset}\n        onExportJson={handleExportJson}\n        onExportMarkdown={handleExportMarkdown}\n      />\n\n      <main className=\"flex-1 flex flex-col\">\n        {!pipelineData ? (\n          // Landing Input State\n          <div className=\"flex-1 flex items-center justify-center p-4\">\n            <QueryInput\n              onStartPipeline={handleStartPipeline}\n              isLoading={false}\n              presets={presets}\n            />\n          </div>\n        ) : (\n          // Active Pipeline State\n          <div className=\"flex-1 flex flex-col\">\n            {/* Active Research Vector Strip */}\n            <div className=\"bg-slate-950 px-4 lg:px-8 py-3 border-b border-slate-800/80\">\n              <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-2 h-2 rounded-full bg-cyan-400 animate-pulse\"></span>\n                  <span className=\"text-[11px] font-mono text-cyan-400 font-semibold uppercase tracking-wider\">\n                    ACTIVE RESEARCH VECTOR:\n                  </span>\n                  <span className=\"text-xs text-slate-300 font-medium truncate max-w-xl\">\n                    &quot;{pipelineData.query}&quot;\n                  </span>\n                </div>\n\n                <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n                  <span\n                    className={`px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase ${\n                      pipelineData.status === \'completed\'\n                        ? \'bg-emerald-950 text-emerald-300 border border-emerald-800\'\n                        : pipelineData.status === \'error\'\n                        ? \'bg-rose-950 text-rose-300 border border-rose-800\'\n                        : \'bg-cyan-950 text-cyan-300 border border-cyan-800 animate-pulse\'\n                    }`}\n                  >\n                    STATUS: {pipelineData.status}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Visual Node Tracker Bar */}\n            <NodePipelineTracker\n              pipelineData={pipelineData}\n              activeTab={activeTab}\n              onSelectTab={(phase) => setActiveTab(phase)}\n              onExecuteStep={handleExecuteStep}\n              isExecutingStep={isExecutingStep}\n            />\n\n            {/* Error Notification if any */}\n            {pipelineData.error && (\n              <div className=\"max-w-7xl mx-auto w-full px-4 lg:px-8 mt-4\">\n                <div className=\"p-3.5 rounded-xl bg-rose-950/40 border border-rose-800/80 text-xs text-rose-200 flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <AlertCircle className=\"w-4 h-4 text-rose-400 shrink-0\" />\n                    <span>{pipelineData.error}</span>\n                  </div>\n                  <button\n                    onClick={() => handleExecuteStep(pipelineData.currentPhase)}\n                    className=\"px-2.5 py-1 rounded bg-rose-900/60 hover:bg-rose-900 text-white font-mono text-[10px] transition-colors\"\n                  >\n                    Retry Phase {pipelineData.currentPhase}\n                  </button>\n                </div>\n              </div>\n            )}\n\n            {/* Tabbed Phase Views */}\n            <div className=\"flex-1 max-w-7xl w-full mx-auto px-4 lg:px-8 py-6 space-y-6\">\n              {activeTab === 1 && (\n                <Phase1DPSView\n                  personas={pipelineData.phase1_dps}\n                  onNextPhase={() => handleExecuteStep(2)}\n                />\n              )}\n\n              {activeTab === 2 && (\n                <Phase2ToTView\n                  totTree={pipelineData.phase2_tot}\n                  onNextPhase={() => handleExecuteStep(3)}\n                />\n              )}\n\n              {activeTab === 3 && (\n                <Phase3MapReduceView\n                  mapReduce={pipelineData.phase3_mapreduce}\n                  onNextPhase={() => handleExecuteStep(4)}\n                />\n              )}\n\n              {activeTab === 4 && (\n                <Phase4DelphiView\n                  delphi={pipelineData.phase4_delphi}\n                  onNextPhase={() => handleExecuteStep(5)}\n                />\n              )}\n\n              {activeTab === 5 && (\n                <Phase5AdversarialView\n                  adversarial={pipelineData.phase5_adversarial}\n                  onNextPhase={() => handleExecuteStep(6)}\n                />\n              )}\n\n              {activeTab === 6 && (\n                <Phase6ReportView report={pipelineData.phase6_report} />\n              )}\n\n              {/* Bottom Live Terminal Logs */}\n              <div className=\"mt-8\">\n                <PipelineLiveLogs\n                  logs={pipelineData.logs}\n                  isStreaming={pipelineData.status === \'running\'}\n                />\n              </div>\n            </div>\n          </div>\n        )}\n      </main>\n\n      {/* Benchmark Presets Modal */}\n      <PresetsModal\n        isOpen={isPresetsOpen}\n        onClose={() => setIsPresetsOpen(false)}\n        presets={presets}\n        onSelectPreset={(pQuery) => handleStartPipeline(pQuery, \'stream\')}\n      />\n    </div>\n  );\n}\n"
    }
