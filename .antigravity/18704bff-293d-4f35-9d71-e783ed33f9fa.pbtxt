    }
    command_line: "node -e \'\nasync function testAll() {\n  // 1. DuckDuckGo Instant Answer API\n  try {\n    const res1 = await fetch(\"https://api.duckduckgo.com/?q=eVTOL&format=json\");\n    const j1 = await res1.json();\n    console.log(\"DDG JSON API Heading:\", j1.Heading, \"RelatedTopics:\", j1.RelatedTopics?.length);\n  } catch(e) { console.log(\"DDG JSON err:\", e.message); }\n\n  // 2. Wikipedia API\n  try {\n    const res2 = await fetch(\"https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=eVTOL%20air%20taxi&format=json&origin=*\");\n    const j2 = await res2.json();\n    console.log(\"Wikipedia hits:\", j2.query?.search?.length, \"First:\", j2.query?.search?.[0]?.title);\n  } catch(e) { console.log(\"Wiki err:\", e.message); }\n\n  // 3. HackerNews Algolia API (search tech, startups, reports, links)\n  try {\n    const res3 = await fetch(\"https://hn.algolia.com/api/v1/search?query=eVTOL%20air%20taxi&tags=story\");\n    const j3 = await res3.json();\n    console.log(\"HN hits:\", j3.hits?.length, \"First URL:\", j3.hits?.[0]?.url, \"Title:\", j3.hits?.[0]?.title);\n  } catch(e) { console.log(\"HN err:\", e.message); }\n\n  // 4. CrossRef\n  try {\n    const res4 = await fetch(\"https://api.crossref.org/works?query=eVTOL+Manhattan&rows=2\");\n    const j4 = await res4.json();\n    console.log(\"CrossRef hits:\", j4.message?.items?.length, \"DOI:\", j4.message?.items?.[0]?.DOI);\n  } catch(e) { console.log(\"CrossRef err:\", e.message); }\n\n  // 5. arXiv API\n  try {\n    const res5 = await fetch(\"http://export.arxiv.org/api/query?search_query=all:eVTOL&start=0&max_results=2\");\n    const text5 = await res5.text();\n    console.log(\"arXiv length:\", text5.length, \"Has entry:\", text5.includes(\"<entry>\"));\n  } catch(e) { console.log(\"arXiv err:\", e.message); }\n}\ntestAll();\n\'"
