    command_line: "node -e \"\nasync function fetchRealWebIntel(query) {\n  const intelItems = [];\n\n  // 1. Google News RSS for live press & industry coverage\n  try {\n    const rssRes = await fetch(\'https://news.google.com/rss/search?q=\' + encodeURIComponent(query) + \'&hl=en-US&gl=US&ceid=US:en\', {\n      headers: { \'User-Agent\': \'Mozilla/5.0\' },\n      signal: AbortSignal.timeout(5000)\n    });\n    if (rssRes.ok) {\n      const xml = await rssRes.text();\n      const itemRegex = /<item>[\\s\\S]*?<title>([\\s\\S]*?)<\\/title>[\\s\\S]*?<link>([\\s\\S]*?)<\\/link>[\\s\\S]*?<pubDate>([\\s\\S]*?)<\\/pubDate>[\\s\\S]*?<source url=\\\"([^\\\"]+)\\\">([\\s\\S]*?)<\\/source>/g;\n      let m;\n      while ((m = itemRegex.exec(xml)) !== null && intelItems.length < 8) {\n        intelItems.push({\n          title: m[1].replace(/&amp;/g, \'&\').replace(/&#39;/g, \\\"\'\\\"),\n          url: m[2],\n          domainUrl: m[4],\n          publisher: m[5],\n          date: m[3],\n          sourceType: \'LIVE_NEWS_DISPATCH\'\n        });\n      }\n    }\n  } catch (e) {}\n\n  // 2. Wikipedia API for verified background context\n  try {\n    const wikiRes = await fetch(\'https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=\' + encodeURIComponent(query.slice(0, 60)) + \'&format=json&origin=*\', {\n      headers: { \'User-Agent\': \'ResearchifyAI/1.0\' },\n      signal: AbortSignal.timeout(4000)\n    });\n    if (wikiRes.ok) {\n      const wj = await wikiRes.json();\n      (wj.query?.search || []).slice(0, 3).forEach(s => {\n        intelItems.push({\n          title: s.title + \' (Wikipedia Verified Overview)\',\n          url: \'https://en.wikipedia.org/wiki/\' + encodeURIComponent(s.title.replace(/ /g, \'_\')),\n          publisher: \'Wikipedia\',\n          date: \'Live Registry\',\n          snippet: s.snippet.replace(/<[^>]+>/g, \'\').trim(),\n          sourceType: \'ENCYCLOPEDIC_REGISTRY\'\n        });\n      });\n    }\n  } catch (e) {}\n\n  return intelItems;\n}\n\nfetchRealWebIntel(\'Sodium-ion battery ERCOT grid storage\').then(items => {\n  console.log(\'Total items fetched for Sodium-ion ERCOT:\', items.length);\n  items.slice(0, 4).forEach((it, i) => console.log(i + 1, it.title, \'Source:\', it.publisher, \'URL:\', it.url.slice(0, 80)));\n});\n\""
    proposed_command_line: "node -e \"\nasync function fetchRealWebIntel(query) {\n  const intelItems = [];\n\n  // 1. Google News RSS for live press & industry coverage\n  try {\n    const rssRes = await fetch(\'https://news.google.com/rss/search?q=\' + encodeURIComponent(query) + \'&hl=en-US&gl=US&ceid=US:en\', {\n      headers: { \'User-Agent\': \'Mozilla/5.0\' },\n      signal: AbortSignal.timeout(5000)\n    });\n    if (rssRes.ok) {\n      const xml = await rssRes.text();\n      const itemRegex = /<item>[\\s\\S]*?<title>([\\s\\S]*?)<\\/title>[\\s\\S]*?<link>([\\s\\S]*?)<\\/link>[\\s\\S]*?<pubDate>([\\s\\S]*?)<\\/pubDate>[\\s\\S]*?<source url=\\\"([^\\\"]+)\\\">([\\s\\S]*?)<\\/source>/g;\n      let m;\n      while ((m = itemRegex.exec(xml)) !== null && intelItems.length < 8) {\n        intelItems.push({\n          title: m[1].replace(/&amp;/g, \'&\').replace(/&#39;/g, \\\"\'\\\"),\n          url: m[2],\n          domainUrl: m[4],\n          publisher: m[5],\n          date: m[3],\n          sourceType: \'LIVE_NEWS_DISPATCH\'\n        });\n      }\n    }\n  } catch (e) {}\n\n  // 2. Wikipedia API for verified background context\n  try {\n    const wikiRes = await fetch(\'https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=\' + encodeURIComponent(query.slice(0, 60)) + \'&format=json&origin=*\', {\n      headers: { \'User-Agent\': \'ResearchifyAI/1.0\' },\n      signal: AbortSignal.timeout(4000)\n    });\n    if (wikiRes.ok) {\n      const wj = await wikiRes.json();\n      (wj.query?.search || []).slice(0, 3).forEach(s => {\n        intelItems.push({\n          title: s.title + \' (Wikipedia Verified Overview)\',\n          url: \'https://en.wikipedia.org/wiki/\' + encodeURIComponent(s.title.replace(/ /g, \'_\')),\n          publisher: \'Wikipedia\',\n          date: \'Live Registry\',\n          snippet: s.snippet.replace(/<[^>]+>/g, \'\').trim(),\n          sourceType: \'ENCYCLOPEDIC_REGISTRY\'\n        });\n      });\n    }\n  } catch (e) {}\n\n  return intelItems;\n}\n\nfetchRealWebIntel(\'Sodium-ion battery ERCOT grid storage\').then(items => {\n  console.log(\'Total items fetched for Sodium-ion ERCOT:\', items.length);\n  items.slice(0, 4).forEach((it, i) => console.log(i + 1, it.title, \'Source:\', it.publisher, \'URL:\', it.url.slice(0, 80)));\n});\n\""
