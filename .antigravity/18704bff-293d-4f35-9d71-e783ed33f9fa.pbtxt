          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const prompt = `[SYSTEM CORE MANDATE]"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
