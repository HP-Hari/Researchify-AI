  file_change {
    absolute_path_uri: "file:///src/components/QueryInput.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ArrowRight, Sparkles, Terminal, Activity, Layers, PlayCircle } from \'lucide-react\';\n\ninterface Preset {\n  id: string;\n  title: string;\n  query: string;\n  industry: string;\n  geo: string;\n}\n\ninterface QueryInputProps {\n  onStartPipeline: (query: string, mode: \'stream\' | \'step\') => void;\n  isLoading: boolean;\n  presets: Preset[];\n}\n\nexport const QueryInput: React.FC<QueryInputProps> = ({\n  onStartPipeline,\n  isLoading,\n  presets,\n}) => {\n  const [query, setQuery] = useState(\'\');\n  const [executionMode, setExecutionMode] = useState<\'stream\' | \'step\'>(\'stream\');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!query.trim() || isLoading) return;\n    onStartPipeline(query.trim(), executionMode);\n  };\n\n  const handleSelectPreset = (pQuery: string) => {\n    setQuery(pQuery);\n  };\n\n  return (\n    <div className=\"w-full max-w-4xl mx-auto py-6 px-4\">\n      {/* Hero Badge */}\n      <div className=\"flex flex-col items-center text-center mb-6\">\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/40 border border-cyan-800/50 text-cyan-300 text-xs font-mono mb-3\">\n          <Activity className=\"w-3.5 h-3.5 text-cyan-400\" />\n          <span>NON-LINEAR SELF-CORRECTING ORCHESTRATION</span>\n        </div>\n        <h2 className=\"text-3xl md:text-4xl font-extrabold text-white tracking-tight font-sans\">\n          Deploy Autonomous Market Intelligence\n        </h2>\n        <p className=\"mt-2 text-sm md:text-base text-slate-400 max-w-2xl\">\n          Ingest raw, unformatted propositions into five isolated processing nodes: dynamic persona synthesis, asymmetric tree-of-thought routing, parallel MapReduce collision radars, and adversarial epistemic adjudication.\n        </p>\n      </div>\n\n      {/* Main Input Card */}\n      <form\n        onSubmit={handleSubmit}\n        className=\"relative rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 shadow-2xl p-4 md:p-6\"\n      >\n        <div className=\"flex items-center justify-between mb-3 text-xs font-mono text-slate-400 border-b border-slate-800/80 pb-2\">\n          <div className=\"flex items-center gap-2\">\n            <Terminal className=\"w-4 h-4 text-cyan-400\" />\n            <span>GLOBAL BUSINESS PROPOSITION / RESEARCH VECTOR</span>\n          </div>\n\n          {/* Mode Switcher */}\n          <div className=\"flex items-center gap-1 bg-slate-950 p-0.5 rounded-lg border border-slate-800\">\n            <button\n              type=\"button\"\n              onClick={() => setExecutionMode(\'stream\')}\n              className={`px-2.5 py-1 rounded text-xs transition-colors flex items-center gap-1.5 cursor-pointer ${\n                executionMode === \'stream\'\n                  ? \'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-medium\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <Sparkles className=\"w-3 h-3 text-cyan-400\" />\n              <span>Autonomous Blitz</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setExecutionMode(\'step\')}\n              className={`px-2.5 py-1 rounded text-xs transition-colors flex items-center gap-1.5 cursor-pointer ${\n                executionMode === \'step\'\n                  ? \'bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 font-medium\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <Layers className=\"w-3 h-3 text-indigo-400\" />\n              <span>Step-by-Step Cadence</span>\n            </button>\n          </div>\n        </div>\n\n        <div className=\"relative\">\n          <textarea\n            value={query}\n            onChange={(e) => setQuery(e.target.value)}\n            placeholder=\"Enter complex venture thesis (e.g., \'Commercial deployment of 100MW/400MWh Sodium-Ion BESS in ERCOT wholesale grid arbitrage versus LFP under 2026 interconnection queue backlogs\')...\"\n            rows={4}\n            disabled={isLoading}\n            className=\"w-full bg-slate-950/80 text-slate-100 placeholder-slate-500 text-sm md:text-base rounded-xl p-3.5 border border-slate-800 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 outline-none resize-none transition-all font-sans leading-relaxed\"\n          />\n        </div>\n\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3 mt-4\">\n          <div className=\"text-[11px] font-mono text-slate-500 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 inline-block\"></span>\n            <span>Zero Data Leakage: Source URLs permanently welded to empirical assertions</span>\n          </div>\n\n          <button\n            type=\"submit\"\n            disabled={!query.trim() || isLoading}\n            className=\"w-full sm:w-auto px-6 py-2.5 rounded-xl font-medium text-sm text-slate-950 bg-gradient-to-r from-cyan-400 to-emerald-400 hover:from-cyan-300 hover:to-emerald-300 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-lg shadow-cyan-500/20 flex items-center justify-center gap-2 cursor-pointer font-sans\"\n          >\n            {isLoading ? (\n              <>\n                <span className=\"w-4 h-4 border-2 border-slate-950 border-t-transparent rounded-full animate-spin\"></span>\n                <span>Engaging Orchestration Grid...</span>\n              </>\n            ) : (\n              <>\n                <span>Launch Analysis</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </>\n            )}\n          </button>\n        </div>\n      </form>\n\n      {/* Curated Presets Carousel / Quick Chips */}\n      <div className=\"mt-6\">\n        <div className=\"flex items-center gap-2 mb-2 text-xs font-mono text-slate-400\">\n          <Sparkles className=\"w-3.5 h-3.5 text-cyan-400\" />\n          <span>HIGH-CONVICTION BENCHMARK PROPOSITIONS</span>\n        </div>\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-2.5\">\n          {presets.map((preset) => (\n            <button\n              key={preset.id}\n              onClick={() => handleSelectPreset(preset.query)}\n              className=\"text-left p-3 rounded-xl bg-slate-900/60 hover:bg-slate-900 border border-slate-800/80 hover:border-slate-700 transition-all group cursor-pointer\"\n            >\n              <div className=\"flex items-center justify-between text-[11px] font-mono text-cyan-400 mb-1\">\n                <span>{preset.industry}</span>\n                <PlayCircle className=\"w-3 h-3 text-slate-500 group-hover:text-cyan-400 transition-colors\" />\n              </div>\n              <div className=\"text-xs font-semibold text-slate-200 group-hover:text-white transition-colors line-clamp-1\">\n                {preset.title}\n              </div>\n              <div className=\"text-[11px] text-slate-500 mt-1 line-clamp-2\">\n                {preset.query}\n              </div>\n            </button>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
