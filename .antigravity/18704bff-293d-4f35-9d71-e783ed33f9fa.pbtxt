    }
    command_line: "node -e \'\nasync function searchWeb(q) {\n  try {\n    const res = await fetch(`https://html.duckduckgo.com/html/?q=${encodeURIComponent(q)}`, {\n      headers: {\n        \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\",\n        \"Accept\": \"text/html\"\n      }\n    });\n    if (!res.ok) return [];\n    const html = await res.text();\n    const results = [];\n    const regex = /<a rel=\"nofollow\" class=\"result__a\" href=\"([^\"]+)\">([\\s\\S]*?)<\\/a>[\\s\\S]*?<a class=\"result__snippet\"[^>]*>([\\s\\S]*?)<\\/a>/g;\n    let m;\n    while ((m = regex.exec(html)) !== null && results.length < 6) {\n      let url = m[1];\n      if (url.includes(\"uddg=\")) {\n        const match = url.match(/uddg=([^&]+)/);\n        if (match) url = decodeURIComponent(match[1]);\n      }\n      if (!url.startsWith(\"http\")) continue;\n      const title = m[2].replace(/<[^>]+>/g, \"\").trim();\n      const snippet = m[3].replace(/<[^>]+>/g, \"\").trim();\n      let domain = \"\";\n      try { domain = new URL(url).hostname.replace(/^www\\./, \"\"); } catch(e){}\n      results.push({ title, url, domain, snippet });\n    }\n    return results;\n  } catch(e) {\n    console.error(\"Search error:\", e);\n    return [];\n  }\n}\n\nasync function run() {\n  const tests = [\n    \"AI autonomous coding agents 2026 enterprise adoption\",\n    \"Robotic micro-pharmacies hospital sterile compounding EU GMP\",\n    \"Manhattan eVTOL air taxi routes FAA certification\"\n  ];\n  for (const t of tests) {\n    const r = await searchWeb(t);\n    console.log(`Query: \"${t}\" => ${r.length} results`);\n    if (r[0]) console.log(\"  Top URL:\", r[0].url, \"| Publisher:\", r[0].domain);\n  }\n}\nrun();\n\'"
    proposed_command_line: "node -e \'\nasync function searchWeb(q) {\n  try {\n    const res = await fetch(`https://html.duckduckgo.com/html/?q=${encodeURIComponent(q)}`, {\n      headers: {\n        \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\",\n        \"Accept\": \"text/html\"\n      }\n    });\n    if (!res.ok) return [];\n    const html = await res.text();\n    const results = [];\n    const regex = /<a rel=\"nofollow\" class=\"result__a\" href=\"([^\"]+)\">([\\s\\S]*?)<\\/a>[\\s\\S]*?<a class=\"result__snippet\"[^>]*>([\\s\\S]*?)<\\/a>/g;\n    let m;\n    while ((m = regex.exec(html)) !== null && results.length < 6) {\n      let url = m[1];\n      if (url.includes(\"uddg=\")) {\n        const match = url.match(/uddg=([^&]+)/);\n        if (match) url = decodeURIComponent(match[1]);\n      }\n      if (!url.startsWith(\"http\")) continue;\n      const title = m[2].replace(/<[^>]+>/g, \"\").trim();\n      const snippet = m[3].replace(/<[^>]+>/g, \"\").trim();\n      let domain = \"\";\n      try { domain = new URL(url).hostname.replace(/^www\\./, \"\"); } catch(e){}\n      results.push({ title, url, domain, snippet });\n    }\n    return results;\n  } catch(e) {\n    console.error(\"Search error:\", e);\n    return [];\n  }\n}\n\nasync function run() {\n  const tests = [\n    \"AI autonomous coding agents 2026 enterprise adoption\",\n    \"Robotic micro-pharmacies hospital sterile compounding EU GMP\",\n    \"Manhattan eVTOL air taxi routes FAA certification\"\n  ];\n  for (const t of tests) {\n    const r = await searchWeb(t);\n    console.log(`Query: \"${t}\" => ${r.length} results`);\n    if (r[0]) console.log(\"  Top URL:\", r[0].url, \"| Publisher:\", r[0].domain);\n  }\n}\nrun();\n\'"
