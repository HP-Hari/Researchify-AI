    command_line: "node -e \"\nfetch(\'https://news.google.com/rss/search?q=\' + encodeURIComponent(\'eVTOL Manhattan JFK 2025\') + \'&hl=en-US&gl=US&ceid=US:en\')\n  .then(r => r.text())\n  .then(xml => {\n    console.log(\'Google News RSS length:\', xml.length);\n    const titles = [];\n    const links = [];\n    const pubDates = [];\n    const itemRegex = /<item>[\\s\\S]*?<title>([\\s\\S]*?)<\\/title>[\\s\\S]*?<link>([\\s\\S]*?)<\\/link>[\\s\\S]*?<pubDate>([\\s\\S]*?)<\\/pubDate>/g;\n    let m;\n    while ((m = itemRegex.exec(xml)) !== null && titles.length < 5) {\n      titles.push(m[1].replace(/&amp;/g, \'&\'));\n      links.push(m[2]);\n      pubDates.push(m[3]);\n    }\n    console.log(\'Found items:\', titles.length);\n    for (let i = 0; i < titles.length; i++) {\n      console.log(i + 1, titles[i], \'| Date:\', pubDates[i], \'| Link:\', links[i].slice(0, 70));\n    }\n  });\n\""
