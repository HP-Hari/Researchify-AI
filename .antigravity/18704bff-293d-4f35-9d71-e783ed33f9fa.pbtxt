  file_change {
    absolute_path_uri: "file:///src/components/Phase1DPSView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Users, UserCheck, ShieldAlert, Award, FileCode } from \'lucide-react\';\nimport type { ExpertPersona } from \'../types\';\n\ninterface Phase1DPSViewProps {\n  personas?: ExpertPersona[];\n  onNextPhase?: () => void;\n}\n\nexport const Phase1DPSView: React.FC<Phase1DPSViewProps> = ({ personas, onNextPhase }) => {\n  if (!personas || personas.length === 0) {\n    return (\n      <div className=\"p-8 text-center bg-slate-900/40 rounded-2xl border border-slate-800 text-slate-400\">\n        <Users className=\"w-10 h-10 mx-auto text-slate-600 mb-3 animate-pulse\" />\n        <p className=\"text-sm font-mono\">DPS Node initializing... Awaiting semantic ontological mapping.</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-slate-900/80 border border-slate-800\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-950 text-cyan-400 border border-cyan-800\">\n              PHASE 1 : DPS NODE\n            </span>\n            <span className=\"text-xs font-mono text-emerald-400 flex items-center gap-1\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></span>\n              Anti-Generalist Policy Enforced\n            </span>\n          </div>\n          <h3 className=\"text-lg font-bold text-white mt-1\">\n            Dynamic Persona Synthesizer (DPS)\n          </h3>\n          <p className=\"text-xs text-slate-400 mt-0.5\">\n            Strictly forbidden from generic titles (e.g., &quot;CFO&quot;). Exactly 3 hyper-specialized expert profiles engineered for this operational vertical.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-start sm:self-auto\">\n          <span className=\"px-3 py-1 rounded-lg bg-slate-950 text-xs font-mono text-slate-300 border border-slate-800 flex items-center gap-1.5\">\n            <FileCode className=\"w-3.5 h-3.5 text-cyan-400\" />\n            <span>3 Personas Validated</span>\n          </span>\n          {onNextPhase && (\n            <button\n              onClick={onNextPhase}\n              className=\"px-3 py-1 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 text-xs font-mono border border-cyan-500/40 cursor-pointer\"\n            >\n              Advance to ToT Router &rarr;\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* 3 Personas Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n        {personas.map((persona, idx) => (\n          <div\n            key={idx}\n            className=\"flex flex-col justify-between p-5 rounded-xl bg-slate-900/90 border border-slate-800/90 hover:border-cyan-500/40 transition-all shadow-lg group relative overflow-hidden\"\n          >\n            <div className=\"absolute top-0 right-0 w-24 h-24 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-colors pointer-events-none\" />\n\n            <div>\n              {/* Persona Badge */}\n              <div className=\"flex items-center justify-between mb-3\">\n                <span className=\"w-7 h-7 rounded-lg bg-cyan-950/80 text-cyan-400 border border-cyan-800/60 flex items-center justify-center text-xs font-mono font-bold\">\n                  0{idx + 1}\n                </span>\n                <span className=\"px-2 py-0.5 rounded text-[10px] font-mono text-slate-400 bg-slate-950 border border-slate-800\">\n                  SYSTEM PROFILE\n                </span>\n              </div>\n\n              {/* Title */}\n              <h4 className=\"text-sm font-bold text-slate-100 group-hover:text-cyan-300 transition-colors leading-snug\">\n                {persona.title}\n              </h4>\n\n              {/* Focus Domain */}\n              <div className=\"mt-3 p-2.5 rounded-lg bg-slate-950/70 border border-slate-800/60\">\n                <div className=\"text-[10px] font-mono text-cyan-400 uppercase tracking-wider mb-1 flex items-center gap-1\">\n                  <Award className=\"w-3 h-3 text-cyan-400\" />\n                  <span>Governed Operational Vertical</span>\n                </div>\n                <p className=\"text-xs text-slate-300 leading-relaxed font-sans\">\n                  {persona.focus_domain}\n                </p>\n              </div>\n\n              {/* Skeptical System Instruction */}\n              <div className=\"mt-3\">\n                <div className=\"text-[10px] font-mono text-amber-400 uppercase tracking-wider mb-1 flex items-center gap-1\">\n                  <ShieldAlert className=\"w-3 h-3 text-amber-400\" />\n                  <span>Skeptical Audit Mandate</span>\n                </div>\n                <p className=\"text-[11px] text-slate-400 leading-relaxed font-mono bg-slate-950/40 p-2.5 rounded border border-slate-800/40 line-clamp-6 hover:line-clamp-none transition-all\">\n                  &quot;{persona.system_instruction}&quot;\n                </p>\n              </div>\n            </div>\n\n            <div className=\"mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-[11px] font-mono text-slate-500\">\n              <span className=\"flex items-center gap-1 text-emerald-400\">\n                <UserCheck className=\"w-3.5 h-3.5\" />\n                <span>Instantiated</span>\n              </span>\n              <span>Node DPS-{idx + 1}</span>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
